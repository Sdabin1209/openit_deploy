	# 상류 장애(FAULT_POLICY 6): Caddy 는 연결 거부·이름 해석 실패를 502, 시간 초과를 504 로 낸다(관찰: docs/E2E.md 5q·5w). 이를 연결 거부 = 503, 시간 초과 = 504 로 바꾸고
	# JSON 본문 {"code":"UPSTREAM_UNAVAILABLE"} 와 Retry-After 를 준다. 본문에 상류 주소·오류 문구를 넣지 않는다(Caddy 의 {http.error.*} 를 쓰지 않는다).
	handle_errors {
		@refused expression {http.error.status_code} in [502, 503]
		@timedout expression {http.error.status_code} == 504
		handle @refused {
			header Content-Type application/json
			header Retry-After 2
			header Cache-Control no-store
			respond `{"code":"UPSTREAM_UNAVAILABLE"}` 503
		}
		handle @timedout {
			header Content-Type application/json
			header Retry-After 2
			header Cache-Control no-store
			respond `{"code":"UPSTREAM_UNAVAILABLE"}` 504
		}
	}
}
