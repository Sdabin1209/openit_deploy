	# 승인 화면 정적 파일: /admin/ 접두사를 떼고 전달한다(이미지는 /admin/ 을 모른다. 화면은 상대 경로 app.js·app.css 를 쓴다)
	redir /admin /admin/ permanent
	handle_path /admin/* {
		import authenticate      # 화면은 어느 역할이든 열린다. API는 위에서 역할로 막힌다
		reverse_proxy https://admin-console {
			header_up X-Forwarded-Host {http.request.hostport}   # 왜: 사이드카가 X-Forwarded-* 를 이웃(사설망)에게서 그대로 받는다(trusted_proxies). 원래 Host 를 앱이 알아야 하는 서비스(Keycloak)용
			header_up Host {upstream_hostport}   # 왜: 상류 사이드카는 서비스 이름 사이트로 TLS 를 끝낸다(Host 로 사이트를 고른다). 원래 Host 는 X-Forwarded-Host 로 남는다
			header_up -X-Openit-User   # 정적 화면에는 클라이언트의 사용자·역할 헤더와 Authorization 을 넘기지 않는다(점검 L1)
			header_up -X-Openit-Roles
			header_up -Authorization
			import proxy_limits 10s
		}
	}
	# 원격 추론 서버(model-runtime)의 릴리스 읽기 경로(D72, ADR 0049): 다른 호스트의 추론 서버는 기동 때 release-gate 의 GET /v1/active-pointer, /v1/releases/{id}, /v1/releases/{id}/bundle 을 직접 읽는다(계약 클라이언트).
	# 사람 계정이 아니라 기계 토큰이다: 요청의 Authorization: Bearer <값> 이 파일 gateway-inference-token 의 값과 같을 때만 열고, 상류에는 model-serving 읽기 토큰(gate-read-model-serving)으로 바꿔 붙인다(release-gate 는 호스트에 게시하지 않는다).
	# 토큰 비교는 위 기기 토큰({file./run/secrets/...} 치환, 설정을 읽을 때 한 번)과 같은 방식이다. 바꾸면 게이트웨이를 다시 시작한다. 사람 계정의 /v1/releases/* 는 계속 404 다(아래 handle /v1/*). 이 블록은 아래 운영자 블록(@operateread)보다 앞이다:
	# 같은 /v1/active-pointer 라도 Bearer 가 맞으면 여기서 끝나고, 사람(OIDC 세션 쿠키)이면 운영자 블록으로 간다.
	# 상한: response_header_timeout 은 **응답 머리글까지만** 재므로(본문 읽기에는 걸리지 않는다) 번들 본문(tar)의 크기·전송 시간과 무관하다. 그래서 번들 경로만의 별도 상한 예외를 두지 않는다(proxy_limits 180s 그대로). 본문 전송 전체의 상한은 두지 않았다(측정하지 않음).
	@inferencemachine {
		method GET
		path /v1/active-pointer /v1/releases/*
		header Authorization "Bearer {file./run/secrets/gateway-inference-token}"
	}
	handle @inferencemachine {
		reverse_proxy https://release-gate {
			header_up X-Forwarded-Host {http.request.hostport}   # 왜: 사이드카가 X-Forwarded-* 를 이웃(사설망)에게서 그대로 받는다(trusted_proxies). 원래 Host 를 앱이 알아야 하는 서비스(Keycloak)용
			header_up Host {upstream_hostport}   # 왜: 상류 사이드카는 서비스 이름 사이트로 TLS 를 끝낸다(Host 로 사이트를 고른다). 원래 Host 는 X-Forwarded-Host 로 남는다
			import proxy_limits 180s
			flush_interval -1   # 번들(tar)은 버퍼링 없이 흘린다: release-gate 노출 선언의 streaming true
			header_up Authorization "Bearer {file./run/secrets/gate-read-model-serving}"
			header_up -X-Openit-User
			header_up -X-Openit-Roles
			header_up -X-Openit-Dn
			header_up -X-Openit-Device
			header_down Cache-Control "no-store"
		}
	}
	# 토큰이 없거나 틀린 기계 호출은 401 이다. 사람(OIDC 세션 쿠키 _openit_session 이 있는 요청)은 건드리지 않는다: 릴리스·번들 경로는 아래 handle /v1/* 가 404 다. 쿠키도 기계 토큰도 없는 요청은 401 + Bearer 안내다. /v1/active-pointer 는 일부러 여기에 넣지 않았다: 자격이 없거나 틀리면 운영자 블록이 Basic 도전(WWW-Authenticate: Basic)으로 401 을 낸다(사람 화면의 계약, scripts/test-gateway-auth.sh).
	@inferencedenied {
		method GET
		path /v1/releases/*
		not header Cookie *_openit_session=*   # 사람 요청의 표지: OIDC 로그인 세션 쿠키(예전에는 Authorization: Basic). 사람은 아래 handle /v1/* 의 404 로 간다
	}
	handle @inferencedenied {
		header WWW-Authenticate "Bearer"
		respond "unauthorized: 추론 서버 토큰이 없거나 틀리다" 401
	}
	# 학습 서버(model-lab 파이프라인)가 모델 패키지를 게시하는 기계 토큰 입구(U69, D122 와 같은 방식, 계약 Exposure kind machine-token):
	# 요청의 Bearer 가 파일 gateway-registry-publish-token 의 값과 같을 때만 열고, 상류(model-registry)에는 레지스트리 쓰기 토큰(model-registry-write-model-lab)을 붙인다.
	# 본문(어댑터 tar, 최대 4GiB)은 response_header_timeout 과 무관하게 흐른다. 사람 계정 경로가 아니므로 X-Openit-User 는 지운다.
	@registrymachine {
		method POST
		path /v1/packages
		header Authorization "Bearer {file./run/secrets/gateway-registry-publish-token}"
	}
	handle @registrymachine {
		reverse_proxy https://model-registry {
			header_up X-Forwarded-Host {http.request.hostport}   # 왜: 사이드카가 X-Forwarded-* 를 이웃(사설망)에게서 그대로 받는다(trusted_proxies). 원래 Host 를 앱이 알아야 하는 서비스(Keycloak)용
			header_up Host {upstream_hostport}   # 왜: 상류 사이드카는 서비스 이름 사이트로 TLS 를 끝낸다(Host 로 사이트를 고른다). 원래 Host 는 X-Forwarded-Host 로 남는다
			import proxy_limits 180s
			header_up Authorization "Bearer {file./run/secrets/model-registry-write-model-lab}"
			header_up -X-Openit-User
			header_up -X-Openit-Roles
			header_up -X-Openit-Dn
			header_up -X-Openit-Device
			header_down Cache-Control "no-store"
		}
	}
	@registrydenied {
		method POST
		path /v1/packages
	}
	handle @registrydenied {
		header WWW-Authenticate "Bearer"
		respond `{"code":"UNAUTHENTICATED","message":"machine token required"}` 401
	}
	# 운영자 경로(D85 E절, admin-console CR-004): 릴리스 운영 화면이 부르는 게이트 경로 넷은 operator 역할 계정 뒤에서만 연다. 아니면 403(인증 없으면 401).
	# 읽기(GET /v1/active-pointer, GET /v1/releases)는 operator **읽기** 토큰, 변경(POST /v1/activate, /v1/rollback)은 operator **쓰기** 토큰을 붙인다.
	# X-Openit-User 는 인증된 계정으로 덮어쓰고(release-gate 가 행위자로 기록) Cache-Control 은 no-store 를 유지한다. 열지 않는 것: /v1/releases/* (번들, I9 PUT 포함), 그 밖의 /v1/*.
	@operateread {
		method GET
		path /v1/active-pointer /v1/releases
	}
	@operatewrite {
		method POST
		path /v1/activate /v1/rollback
	}
	handle @operateread {
		import authenticate
		handle @role_operator {
			reverse_proxy https://release-gate {
				header_up X-Forwarded-Host {http.request.hostport}   # 왜: 사이드카가 X-Forwarded-* 를 이웃(사설망)에게서 그대로 받는다(trusted_proxies). 원래 Host 를 앱이 알아야 하는 서비스(Keycloak)용
				header_up Host {upstream_hostport}   # 왜: 상류 사이드카는 서비스 이름 사이트로 TLS 를 끝낸다(Host 로 사이트를 고른다). 원래 Host 는 X-Forwarded-Host 로 남는다
				import proxy_limits 180s
				header_up Authorization "Bearer {file./run/secrets/gate-read-operator}"
				header_up X-Openit-User "{http.request.header.X-Auth-Request-Preferred-Username}"
				header_up X-Openit-Roles "{http.request.header.X-Auth-Request-Groups}"   # 계약 CONVENTIONS 6절(3.4.0): 인증 계정의 역할 목록. 클라이언트가 보낸 같은 헤더는 덮어쓴다
				header_down Cache-Control "no-store"
			}
		}
		handle {
			respond "forbidden: operator 역할이 아니다" 403
		}
	}
	handle @operatewrite {
		import authenticate
		request_body {
			max_size 1MiB
		}
		handle @role_operator {
			reverse_proxy https://release-gate {
				header_up X-Forwarded-Host {http.request.hostport}   # 왜: 사이드카가 X-Forwarded-* 를 이웃(사설망)에게서 그대로 받는다(trusted_proxies). 원래 Host 를 앱이 알아야 하는 서비스(Keycloak)용
				header_up Host {upstream_hostport}   # 왜: 상류 사이드카는 서비스 이름 사이트로 TLS 를 끝낸다(Host 로 사이트를 고른다). 원래 Host 는 X-Forwarded-Host 로 남는다
				import proxy_limits 180s
				header_up Authorization "Bearer {file./run/secrets/gate-write-operator}"
				header_up X-Openit-User "{http.request.header.X-Auth-Request-Preferred-Username}"
				header_up X-Openit-Roles "{http.request.header.X-Auth-Request-Groups}"   # 계약 CONVENTIONS 6절(3.4.0): 인증 계정의 역할 목록. 클라이언트가 보낸 같은 헤더는 덮어쓴다
				header_down Cache-Control "no-store"
			}
		}
		handle {
			respond "forbidden: operator 역할이 아니다" 403
		}
	}
	# 키오스크 공개 API(PUBLIC_API.md, D85 F절): 기기 토큰(Authorization: Bearer, 기기마다 파일 하나)을 목록과 대조한 뒤에만 서비스 kiosk 토큰으로 바꿔 붙인다.
	# 토큰이 없거나 틀리면 401. 클라이언트가 보낸 X-Openit-User 는 지운다. /v1/staff 는 위에서만 staff 토큰을 받는다.
	# 위험 신호 입력(risk-source)과 결과 조회(result-reader)는 감지기·병원 시스템용 내부 면이다: 게이트웨이에 열지 않는다(D85). 키오스크 경로의 와일드카드가 삼키지 않게 먼저 닫는다.
	# 저자 경로: 문항 자료 등록(POST /v1/materials), 초안 조회·편집·확인(/v1/drafts*), 임상 근거 승인(POST /v1/reviews). 읽기 면(I1: /v1/question-sets/{id}/…)은 열지 않는다(이웃 서비스용). 정확히 /v1/question-sets 는 키오스크 목록(I10)이라 @kioskapi 에서 기기 인증으로 연다.
	# 개선 신호 읽기(GET /v1/signals, D88/U9 환류): 저자가 운영 환류를 읽는 유일한 사람 입구다. 2026-11-01 E2E 샌드박스 전환(D123)에서 이 입구가 없어 저자가 신호를 볼 수 없음이 드러나 열었다(U68). 읽기만 연다(쓰기 없음).
	@qasignals {
		method GET
		path /v1/signals
	}
	@qaauthor path /v1/materials /v1/drafts /v1/drafts/* /v1/reviews
	handle @qasignals {
		import authenticate
		handle @role_author {
			import qa_proxy
		}
		handle @role_clinical-reviewer {
			import qa_proxy
		}
		handle {
			respond "forbidden: author 또는 clinical-reviewer 역할이 아니다" 403
		}
	}
	handle @qaauthor {
		import authenticate
		handle @role_author {
			import qa_proxy
		}
		handle @role_clinical-reviewer {
			import qa_proxy
		}
		handle {
			respond "forbidden: author 또는 clinical-reviewer 역할이 아니다" 403
		}
	}
	# 문진 결과(U83, 3.2.0 PUBLIC_API B절): 의사(clinician 역할 계정)가 결과 목록·상세를 보고 확인 표시를 한다. 상류에는 result-reader 토큰을 붙이고 인증 계정을 X-Openit-User 로 넘긴다(접근 기록·acknowledged_by).
	@clinicianread {
		method GET
		path /v1/results /v1/results/*
	}
	@clinicianack {
		method POST
		path /v1/results/*/ack
	}
	handle @clinicianread {
		import authenticate
		handle @role_clinician {
			reverse_proxy https://survey-service {
				header_up X-Forwarded-Host {http.request.hostport}   # 왜: 사이드카가 X-Forwarded-* 를 이웃(사설망)에게서 그대로 받는다(trusted_proxies). 원래 Host 를 앱이 알아야 하는 서비스(Keycloak)용
				header_up Host {upstream_hostport}   # 왜: 상류 사이드카는 서비스 이름 사이트로 TLS 를 끝낸다(Host 로 사이트를 고른다). 원래 Host 는 X-Forwarded-Host 로 남는다
				import proxy_limits 55s   # 라벨(survey-service 노출 선언) response_header 55000ms
				header_up Authorization "Bearer {file./run/secrets/survey-result-reader}"
				header_up X-Openit-User "{http.request.header.X-Auth-Request-Preferred-Username}"
				header_up X-Openit-Roles "{http.request.header.X-Auth-Request-Groups}"   # 계약 CONVENTIONS 6절(3.4.0): 인증 계정의 역할 목록. 클라이언트가 보낸 같은 헤더는 덮어쓴다
				header_up -X-Openit-Dn
				header_up -X-Openit-Device
				header_down Cache-Control "no-store"
			}
		}
		handle {
			respond "forbidden: clinician 역할이 아니다" 403
		}
	}
	handle @clinicianack {
		import authenticate
		request_body {
			max_size 16KiB
		}
		handle @role_clinician {
			reverse_proxy https://survey-service {
				header_up X-Forwarded-Host {http.request.hostport}   # 왜: 사이드카가 X-Forwarded-* 를 이웃(사설망)에게서 그대로 받는다(trusted_proxies). 원래 Host 를 앱이 알아야 하는 서비스(Keycloak)용
				header_up Host {upstream_hostport}   # 왜: 상류 사이드카는 서비스 이름 사이트로 TLS 를 끝낸다(Host 로 사이트를 고른다). 원래 Host 는 X-Forwarded-Host 로 남는다
				import proxy_limits 55s   # 라벨(survey-service 노출 선언) response_header 55000ms
				header_up Authorization "Bearer {file./run/secrets/survey-result-reader}"
				header_up X-Openit-User "{http.request.header.X-Auth-Request-Preferred-Username}"
				header_up X-Openit-Roles "{http.request.header.X-Auth-Request-Groups}"   # 계약 CONVENTIONS 6절(3.4.0): 인증 계정의 역할 목록. 클라이언트가 보낸 같은 헤더는 덮어쓴다
				header_up -X-Openit-Dn
				header_up -X-Openit-Device
