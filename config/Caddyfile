{
	admin off
	auto_https off
}
:8080 {
	# 공개 API(I10, PUBLIC_API.md): 세션 시작·발화·종료만 survey-service로 넘긴다. 직원 개입(/intervention)은 외부 입구로 열지 않는다.
	# 인증(Bearer 토큰)은 survey-service가 한다. TLS·도메인은 미정이라 지금은 HTTP.
	@intervention path /v1/sessions/*/intervention
	handle @intervention {
		respond "not found" 404
	}
	@kiosk path /v1/sessions /v1/sessions/*
	handle @kiosk {
		reverse_proxy survey-service:8080
	}
	handle /healthz {
		respond "ok" 200
	}
	handle /readyz {
		respond "ok" 200
	}
	handle {
		respond "not found" 404
	}
}
