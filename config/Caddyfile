{
	admin off
	# TLS(D88/U5, ADR 0005): gateway 는 HTTPS 필수. 인증서는 Caddy 내부 CA(tls internal)가 기본이고 공인 인증서(ACME)는 GATEWAY_HOSTS 에 도메인을 적고 해당 사이트의 `tls internal` 줄을 지워 전환한다.
	# 평문 포트의 자동 리다이렉트는 쓰지 않고(아래 http:// 사이트가 /healthz 만 평문으로 남기고 나머지를 308 으로 보낸다) 컨테이너 안에서 시스템 신뢰 저장소를 건드리지 않는다.
	auto_https disable_redirects
	skip_install_trust
	# IP 로 접속하는 클라이언트(SNI 없음)에게 내줄 인증서의 이름
	default_sni 127.0.0.1
	# 인증 결과 헤더(X-Auth-Request-*)를 지우는 request_header 가 forward_auth 보다 먼저 돌아야 위조된 헤더가 인증 판정에 남지 않는다(Caddy 기본 순서는 forward_auth 가 앞)
	order request_header before forward_auth
}
# 토큰은 환경 변수가 아니라 Caddy 표준 파일 치환 {file./run/secrets/<이름>} 으로 읽는다(D84; 설정을 읽을 때 한 번 치환되고 컨테이너 환경에 값이 없다).
# 사람 인증(U82, head ADR 0014, deploy ADR 0057): 직원·운영자·승인자·검토자·저자·의사·admin 을 OIDC(Keycloak + oauth2-proxy)로 인증한다. 정적 계정 파일·basic_auth 는 없다.
# config/gateway-auth.caddy 가 두 조각을 정의한다: (authenticate) = oauth2-proxy 에 묻는 forward_auth, (role_matchers) = 그룹 -> 역할. 이 Caddyfile 의 나머지는 두 조각의 이름만 안다.
import /etc/caddy/auth.caddy
# 키오스크 기기 인증(D85 F절): (kiosk_devices) 가 @device_ok 를 정의한다. 기기 토큰 목록은 secrets/gateway-devices.caddy (scripts/kiosk-add-device.sh).
import /etc/caddy/devices.caddy
# 키오스크 기기 인증(2.3.0, D113, ADR 0040): 게이트웨이가 클라이언트 인증서를 검증하고 주체 CN 을 X-Openit-Device 로 서비스에 넘긴다. 신뢰할 CA 한 개는 파일 설정이다(비밀 아님):
# /etc/caddy/device-tls.caddy 가 (device_client_auth) 를 정의한다. 기본 파일은 비어 있어(검증 꺼짐) 기기 토큰(2.x 호환)만 쓴다. 켜는 법: config/device-tls.mtls.caddy.example, docs/runbook.md 9-2.
import /etc/caddy/device-tls.caddy
# 사람이 쓰는 화면(승인·운영·검토·저작)과 정적 화면의 상류 상한(FAULT_POLICY 4·6, D125): 환자 경로(연결 1s + 헤더 55s, 키오스크 대기 60s 안)와 달리 키오스크의 60초 한도가 없다.
# 화면이 무한정 매달리지 않게 상한을 둔다. 연결 1s(같은 서버의 컨테이너라 거의 즉시, 느리면 장애), 응답 헤더는 인자로 받는다: release-gate 180s(측정 최악 승인 128초 위의 여유, D120 계기), question-authoring 120s(측정 최악 자료 올리기 62초 위의 여유), ops-feedback 60s(프록시 표준 60초, 측정 최악 11초), 정적 화면 10s(정적 파일).
# 사슬 규칙(바깥이 안쪽보다 길다): 서버 전체 마감(170/110/55초) < 이 상한(연결+헤더 181/121/61초) < 화면 대기(admin-console 190/130/70초) — scripts/test_time_chain.py, ADR 0051(ADR 0048 대체), CONVENTIONS 시간표 D125. 재시도 없음. 초과하면 아래 handle_errors 가 503/504 UPSTREAM_UNAVAILABLE 을 준다.
(proxy_limits) {
	lb_try_duration 0
	transport http {
		tls_trusted_ca_certs /etc/openit/pki/root_ca.crt
		dial_timeout 1s
		response_header_timeout {args[0]}
	}
}
# 평문 포트(컨테이너 8080): 컨테이너 헬스체크와 서버 안 점검용 /healthz 만 평문으로 답하고, 나머지는 HTTPS 로 영구 이동(308: 메서드와 본문을 유지)시킨다.
# GATEWAY_PUBLIC_TLS_PORT 는 밖에서 보이는 HTTPS 포트(운영 443, 기본 8443).
# 저작 서비스 프록시(저자 경로, D88/U9): 사람 인증(개별 계정, 역할 author 또는 clinical-reviewer)을 마친 요청에만 gateway 서비스 토큰(QA_GATEWAY_TOKENS)과 인증된 사용자 ID(X-Openit-User)를 붙인다.
# 클라이언트가 보낸 Authorization·X-Openit-User 는 덮어쓴다. 역할별 권한(저자 != 검수자)은 서비스가 X-Openit-Roles(게이트웨이가 계정 역할에서 붙인다)로 정한다. 본문 상한은 사이트 기본 8MiB(자료 업로드).
(qa_proxy) {
	reverse_proxy https://question-authoring {
		header_up X-Forwarded-Host {http.request.hostport}   # 왜: 사이드카가 X-Forwarded-* 를 이웃(사설망)에게서 그대로 받는다(trusted_proxies). 원래 Host 를 앱이 알아야 하는 서비스(Keycloak)용
		header_up Host {upstream_hostport}   # 왜: 상류 사이드카는 서비스 이름 사이트로 TLS 를 끝낸다(Host 로 사이트를 고른다). 원래 Host 는 X-Forwarded-Host 로 남는다
		import proxy_limits 120s
		header_up Authorization "Bearer {file./run/secrets/qa-gateway-token}"
		header_up X-Openit-User "{http.request.header.X-Auth-Request-Preferred-Username}"
		header_up X-Openit-Roles "{http.request.header.X-Auth-Request-Groups}"   # 계약 CONVENTIONS 6절(3.4.0): 인증 계정의 역할 목록. 클라이언트가 보낸 같은 헤더는 덮어쓴다
		header_down Cache-Control "no-store"
	}
}
http://:8080 {
	handle /healthz {
		respond "ok" 200
	}
	handle {
		redir https://{host}:{$GATEWAY_PUBLIC_TLS_PORT:8443}{uri} 308
	}
}
# HTTPS 사이트(컨테이너 8443). 사이트 이름 목록은 GATEWAY_HOSTS(기본 localhost, 127.0.0.1). 운영에서는 병원 내부 도메인을 적는다(예: kiosk.hospital.local:8443).
{$GATEWAY_HOSTS:localhost:8443, 127.0.0.1:8443} {
	tls {
		issuer internal
		import device_client_auth
	}
	import role_matchers
	import kiosk_devices
	# 기기 ID = 검증된 클라이언트 인증서 주체(RFC 2253 문자열, 예: CN=kiosk-1,O=...)의 CN. 형식 ^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$ 를 만족할 때만 기기로 본다(아니면 기기 인증 실패).
	# Caddy 에는 CN 만 내는 플레이스홀더가 없어, 주체 전체를 내부 헤더 X-Openit-Dn 에 항상 덮어쓰고(클라이언트가 보낸 값은 이 줄이 대체한다: 접두어 dn= 때문에 값이 비어 지워질 일이 없다)
	# header_regexp 의 이름 있는 캡처(re.devcn.1)로 CN 을 꺼낸다. X-Openit-Dn 은 서비스로 가기 전에 지운다. 인증서 자체의 신뢰 검증은 TLS 핸드셰이크(client_auth)가 한다.
	request_header X-Openit-Dn "dn={http.request.tls.client.subject}"
	@device_cert header_regexp devcn X-Openit-Dn ^dn=(?:.*,)?CN=([A-Za-z0-9][A-Za-z0-9._:-]{0,127})(?:,|$)
	# 접근 로그: 요청 본문은 남기지 않는다(Caddy는 본문을 기록하지 않는다). Authorization 헤더는 Caddy가 REDACTED로 바꾼다.
	log {
		output stdout
		format json
	}
	# 요청 본문 상한(점검 B4·D5·G3): 사이트 기본 8MiB(계약 상한), 사람이 쓰는 승인·운영·검토 경로 중 **쓰기(POST) 3곳**(승인 결정, 운영자 activate/rollback, 검토 게시)만 1MiB(JSON 몇 줄뿐). 읽기 경로와 직원·저자 경로는 사이트 기본 8MiB. 초과하면 Caddy 가 413 으로 끊는다. 값은 시작값이다.
	request_body {
		max_size 8MiB
	}
	# 보안 헤더(B7): 정적 화면 이미지가 같은 헤더를 이미 붙이더라도 gateway 가 한 곳에서 보장한다. 마이크(STT)를 쓰는 키오스크 때문에 Permissions-Policy 는 두지 않는다.
	# HSTS: HTTPS 필수(D88/U5)이므로 켠다(1년). includeSubDomains/preload 는 도메인이 정해진 뒤에 판단한다.
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		-Server
		Strict-Transport-Security "max-age=31536000"
	}
	# 기기 설정 파일(/config.json)은 기기마다 그 기기의 정적 서버가 낸다(scripts/kiosk-add-device.sh). 중앙 kiosk-frontend 에는 기기 토큰 파일을 마운트하지 않고, 인증 없는 경로로 새지 않게 여기서도 막는다.
	# 교차 사이트 요청 방어(CSRF, 점검 M2): 상태를 바꾸는 메서드에서 브라우저가 보내는 Sec-Fetch-Site 가 same-origin·none 이 아니거나, Origin 이 이 사이트(https://호스트:포트)와 다르면 403.
	# 브라우저만 이 헤더를 보내므로 curl·서비스 간 호출·E2E 에는 영향이 없다. 키오스크 앱은 같은 출처(gateway 가 낸 화면)라 통과한다. 헤더가 없는 요청은 막지 않는다(브라우저 밖 클라이언트).
	# L20(ADR 0056): 허용 출처는 GATEWAY_HOSTS 에서 만든다. 요청 Host 의 호스트 이름이 GATEWAY_HOST_NAMES(lib.sh 가 GATEWAY_HOSTS 에서 포트를 떼어 만든 목록) 안에 있어야 하고, Origin 은 정확히 https://<Host 의 host:port> 여야 한다.
	# 포트는 목록에서 고정하지 않는다: 밖에 게시된 포트가 컨테이너 포트(8443)와 다를 수 있고(데모·E2E 는 Docker 배정 포트) 브라우저가 보내는 Host 의 포트가 실제 출처의 포트이기 때문이다. 다른 포트의 같은 호스트(다른 출처)는 Origin 과 Host 가 달라 막힌다.
	@csrf expression `{http.request.method} in ["POST", "PUT", "PATCH", "DELETE"] && (({http.request.header.Sec-Fetch-Site} != "" && !({http.request.header.Sec-Fetch-Site} in ["same-origin", "none"])) || ({http.request.header.Origin} != "" && (!({http.request.host} in [{$GATEWAY_HOST_NAMES}]) || {http.request.header.Origin} != "https://" + {http.request.hostport})))`
	handle @csrf {
		respond "forbidden: 교차 출처 요청은 허용하지 않는다" 403
	}
	handle /config.json {
		respond "not found" 404
	}
	handle /healthz {
		respond "ok" 200
	}
	# /readyz: 환자 경로의 survey-service /readyz 를 반영한다(FAULT_POLICY 5). 2xx 면 "ok" 200, 아니면 서비스의 상태 코드를 그대로 두되 본문은 {"ready":false} 만(서비스의 내부 문제 목록은 밖에 내지 않는다).
	# 상류에 닿지 못하면 아래 handle_errors 가 503/504 와 UPSTREAM_UNAVAILABLE 을 준다. /healthz 는 상류와 무관한 정적 200.
	handle /readyz {
		reverse_proxy https://survey-service {
			header_up X-Forwarded-Host {http.request.hostport}   # 왜: 사이드카가 X-Forwarded-* 를 이웃(사설망)에게서 그대로 받는다(trusted_proxies). 원래 Host 를 앱이 알아야 하는 서비스(Keycloak)용
			header_up Host {upstream_hostport}   # 왜: 상류 사이드카는 서비스 이름 사이트로 TLS 를 끝낸다(Host 로 사이트를 고른다). 원래 Host 는 X-Forwarded-Host 로 남는다
				header_up -X-Openit-Dn
				header_up -X-Openit-Device   # 클라이언트가 보낸 기기 헤더는 항상 지운다(게이트웨이만 인증서에서 붙인다, 계약 PUBLIC_API F절)
			header_up -X-Openit-User   # 공개 /readyz 에 클라이언트의 사용자 헤더·자격을 넘기지 않는다(점검 L1)
			header_up -X-Openit-Roles
			header_up -Authorization
			lb_try_duration 0
			transport http {
				tls_trusted_ca_certs /etc/openit/pki/root_ca.crt   # 서비스 사이드카 인증서는 deploy step-ca 가 발급한다: 루트만 신뢰(ADR 0060)
				dial_timeout 1s
				response_header_timeout 2s
			}
			@up status 2xx
			handle_response @up {
				respond "ok" 200
			}
			handle_response {
				header Content-Type application/json
				header Cache-Control no-store
				respond `{"ready":false}` {rp.status_code}
			}
		}
	}
	# 직원 API와 개입: 개별 계정 인증 + staff 역할 뒤에만 staff 서비스 토큰을 붙인다. 인증된 계정 ID 를 X-Openit-User 로 붙이고(개입 기록의 staff_id, 클라이언트가 보낸 값은 덮어씀) 본문 값은 믿지 않는다.
	# SSE는 버퍼링을 끄고 읽기 제한 시간을 길게, Last-Event-ID와 id는 그대로 전달한다.
	@staffapi path /v1/staff/* /v1/sessions/*/intervention
	# 의사(clinician)에게 더 여는 푸시 경로(아래 @staffapi 안): 매처는 사이트 최상위에 둔다(check_exposure 의 구문 분석기가 최상위 매처만 읽는다)
	@clinicianpush path /v1/staff/push-config /v1/staff/push-subscriptions /v1/staff/push-subscriptions/unsubscribe
	handle @staffapi {
		import authenticate
		handle @role_staff {
			reverse_proxy https://survey-service {
				header_up X-Forwarded-Host {http.request.hostport}   # 왜: 사이드카가 X-Forwarded-* 를 이웃(사설망)에게서 그대로 받는다(trusted_proxies). 원래 Host 를 앱이 알아야 하는 서비스(Keycloak)용
				header_up Host {upstream_hostport}   # 왜: 상류 사이드카는 서비스 이름 사이트로 TLS 를 끝낸다(Host 로 사이트를 고른다). 원래 Host 는 X-Forwarded-Host 로 남는다
				header_up -X-Openit-Dn
				header_up -X-Openit-Device   # 클라이언트가 보낸 기기 헤더는 항상 지운다(게이트웨이만 인증서에서 붙인다, 계약 PUBLIC_API F절)
				header_up Authorization "Bearer {file./run/secrets/survey-api-staff}"
				header_up X-Openit-User "{http.request.header.X-Auth-Request-Preferred-Username}"
				header_up X-Openit-Roles "{http.request.header.X-Auth-Request-Groups}"   # 계약 CONVENTIONS 6절(3.4.0): 인증 계정의 역할 목록. 클라이언트가 보낸 같은 헤더는 덮어쓴다
				flush_interval -1
				lb_try_duration 0
				transport http {
					tls_trusted_ca_certs /etc/openit/pki/root_ca.crt   # 서비스 사이드카 인증서는 deploy step-ca 가 발급한다: 루트만 신뢰(ADR 0060)
					# 사슬(ADR 0051, CONVENTIONS 시간표 D125): 연결 1s + 응답 헤더 55s = 56s 는 서버 턴 마감 50s 보다 길고 직원 화면 대기(kiosk-frontend REQUEST_TIMEOUT_MS 60s)보다 짧다. 응답 헤더가 오기 전까지만의 상한이고 SSE 읽기(read_timeout 1h)는 그대로다
					dial_timeout 1s
					response_header_timeout 55s
					read_timeout 1h
				}
			}
		}
		# 의사(clinician)는 푸시 설정·구독 경로만 더 쓸 수 있다(계약 3.4.0 U92: topics results 는 clinician 만). 직원 API 의 나머지(알림 목록·개입 등)는 계속 staff 전용이다
		handle @role_clinician {
			handle @clinicianpush {
				# clinician 전용 계정은 result-reader 토큰이다: survey-service 는 topics results 구독을 result-reader 토큰 요청에만 허용한다(staff 토큰이면 403). staff 도 가진 계정은 위 staff 블록이 먼저 잡아 staff 토큰 + X-Openit-Roles 를 넘긴다
				reverse_proxy https://survey-service {
					header_up X-Forwarded-Host {http.request.hostport}   # 왜: 사이드카가 X-Forwarded-* 를 이웃(사설망)에게서 그대로 받는다(trusted_proxies). 원래 Host 를 앱이 알아야 하는 서비스(Keycloak)용
					header_up Host {upstream_hostport}   # 왜: 상류 사이드카는 서비스 이름 사이트로 TLS 를 끝낸다(Host 로 사이트를 고른다). 원래 Host 는 X-Forwarded-Host 로 남는다
					header_up -X-Openit-Dn
					header_up -X-Openit-Device
					header_up Authorization "Bearer {file./run/secrets/survey-result-reader}"
					header_up X-Openit-User "{http.request.header.X-Auth-Request-Preferred-Username}"
					header_up X-Openit-Roles "{http.request.header.X-Auth-Request-Groups}"   # 계약 CONVENTIONS 6절(3.4.0): 인증 계정의 역할 목록. 클라이언트가 보낸 같은 헤더는 덮어쓴다
					lb_try_duration 0
					transport http {
						tls_trusted_ca_certs /etc/openit/pki/root_ca.crt   # 서비스 사이드카 인증서는 deploy step-ca 가 발급한다: 루트만 신뢰(ADR 0060)
						dial_timeout 1s
						response_header_timeout 55s
					}
				}
			}
			handle {
				respond "forbidden: staff 역할이 아니다" 403
			}
		}
		handle {
			respond "forbidden: staff 역할이 아니다" 403
		}
	}
	# 출고 승인 화면(admin-console): 사람 인증 뒤에만, release-gate의 승인 경로 네 개만 프록시한다: 읽기(GET) 두 경로는 release-approver **읽기** 토큰, 결정(POST /v1/approvals)은 release-approver **쓰기** 토큰을 붙인다(게이트는 읽기 면에서 쓰기 토큰을 403으로 거부한다).
	# 열지 않는 것: POST /v1/submissions, /v1/releases/*  (아래 handle /v1/* 가 404). /v1/active-pointer, /v1/releases, /v1/activate, /v1/rollback 은 아래 운영자 블록에서만 연다.
	# 인증된 사용자 ID를 X-Openit-User 로 붙이고 클라이언트가 보낸 같은 이름 헤더는 덮어쓴다(D69). 응답의 X-Openit-Report-Hash 는 그대로 통과하고 Cache-Control 은 no-store를 유지한다.
	@adminread {
		method GET
		path /v1/submissions /v1/submissions/*
	}
	@adminwrite {
		method POST
		path /v1/approvals
	}
	handle @adminread {
		import authenticate
		handle @role_approver {
			reverse_proxy https://release-gate {
				header_up X-Forwarded-Host {http.request.hostport}   # 왜: 사이드카가 X-Forwarded-* 를 이웃(사설망)에게서 그대로 받는다(trusted_proxies). 원래 Host 를 앱이 알아야 하는 서비스(Keycloak)용
				header_up Host {upstream_hostport}   # 왜: 상류 사이드카는 서비스 이름 사이트로 TLS 를 끝낸다(Host 로 사이트를 고른다). 원래 Host 는 X-Forwarded-Host 로 남는다
				import proxy_limits 180s
				header_up Authorization "Bearer {file./run/secrets/gate-read-release-approver}"
				header_up X-Openit-User "{http.request.header.X-Auth-Request-Preferred-Username}"
				header_up X-Openit-Roles "{http.request.header.X-Auth-Request-Groups}"   # 계약 CONVENTIONS 6절(3.4.0): 인증 계정의 역할 목록. 클라이언트가 보낸 같은 헤더는 덮어쓴다
				header_down Cache-Control "no-store"
			}
		}
		handle {
			respond "forbidden: release-approver 역할이 아니다" 403
		}
	}
	handle @adminwrite {
		import authenticate
		request_body {
			max_size 1MiB
		}
		handle @role_approver {
			reverse_proxy https://release-gate {
				header_up X-Forwarded-Host {http.request.hostport}   # 왜: 사이드카가 X-Forwarded-* 를 이웃(사설망)에게서 그대로 받는다(trusted_proxies). 원래 Host 를 앱이 알아야 하는 서비스(Keycloak)용
				header_up Host {upstream_hostport}   # 왜: 상류 사이드카는 서비스 이름 사이트로 TLS 를 끝낸다(Host 로 사이트를 고른다). 원래 Host 는 X-Forwarded-Host 로 남는다
				import proxy_limits 180s
				header_up Authorization "Bearer {file./run/secrets/gate-write-release-approver}"
				header_up X-Openit-User "{http.request.header.X-Auth-Request-Preferred-Username}"
				header_up X-Openit-Roles "{http.request.header.X-Auth-Request-Groups}"   # 계약 CONVENTIONS 6절(3.4.0): 인증 계정의 역할 목록. 클라이언트가 보낸 같은 헤더는 덮어쓴다
				header_down Cache-Control "no-store"
			}
		}
		handle {
			respond "forbidden: release-approver 역할이 아니다" 403
		}
	}
	# 실패 사례 검토 화면(admin-console): reviewer 역할 계정만. 읽기 3경로는 ops-feedback 읽기 토큰, 검토 게시는 reviewer 쓰기 토큰.
	# 비식별 전 원본(POST /v1/traces 등 서비스 내부 면)은 열지 않는다. X-Openit-User 는 인증된 계정으로 덮어쓴다(클라이언트 값 무시).
	@reviewread {
		method GET
		path /v1/cases /v1/cases/* /v1/deidentified-traces/*
	}
	@reviewwrite {
		method POST
		path /v1/cases/*/review
	}
	handle @reviewread {
		import authenticate
		handle @role_reviewer {
			reverse_proxy https://ops-feedback-ingest {
				header_up X-Forwarded-Host {http.request.hostport}   # 왜: 사이드카가 X-Forwarded-* 를 이웃(사설망)에게서 그대로 받는다(trusted_proxies). 원래 Host 를 앱이 알아야 하는 서비스(Keycloak)용
				header_up Host {upstream_hostport}   # 왜: 상류 사이드카는 서비스 이름 사이트로 TLS 를 끝낸다(Host 로 사이트를 고른다). 원래 Host 는 X-Forwarded-Host 로 남는다
				import proxy_limits 60s
				header_up Authorization "Bearer {file./run/secrets/ops-read-reviewer}"
				header_up X-Openit-User "{http.request.header.X-Auth-Request-Preferred-Username}"
				header_up X-Openit-Roles "{http.request.header.X-Auth-Request-Groups}"   # 계약 CONVENTIONS 6절(3.4.0): 인증 계정의 역할 목록. 클라이언트가 보낸 같은 헤더는 덮어쓴다
				header_down Cache-Control "no-store"
