	# 활성 문진표 목록(I10 GET /v1/question-sets, 계약 3.3.0)은 세션과 같은 기기 인증 범위다: 정확히 이 경로만 연다. 쿼리(I4 ?question_set_id= 등)는 path 매처가 보지 않으므로 막히지 않는다.
	# I1 읽기 면(/v1/question-sets/{id}/versions 등 하위 경로)은 여전히 아래 `handle /v1/*` 의 404 다(이웃 서비스용). 서비스 쪽은 GET 만 받는다(다른 메서드는 서비스가 405)
	@kioskapi path /v1/sessions /v1/sessions/* /v1/question-sets
	handle @kioskapi {
		handle @device_cert {
			# 인증서 기반 기기 인증(2.3.0): 신뢰 CA 가 발급한 인증서만 여기까지 온다(TLS 핸드셰이크에서 검증). 헤더는 위에서 지운 뒤 CN 으로 다시 붙인다
			reverse_proxy https://survey-service {
				header_up X-Forwarded-Host {http.request.hostport}   # 왜: 사이드카가 X-Forwarded-* 를 이웃(사설망)에게서 그대로 받는다(trusted_proxies). 원래 Host 를 앱이 알아야 하는 서비스(Keycloak)용
				header_up Host {upstream_hostport}   # 왜: 상류 사이드카는 서비스 이름 사이트로 TLS 를 끝낸다(Host 로 사이트를 고른다). 원래 Host 는 X-Forwarded-Host 로 남는다
				header_up -X-Openit-Dn
				header_up X-Openit-Device "{re.devcn.1}"
				header_up -X-Openit-User
				header_up -X-Openit-Roles
				header_up -Authorization
				lb_try_duration 0
				transport http {
					tls_trusted_ca_certs /etc/openit/pki/root_ca.crt   # 서비스 사이드카 인증서는 deploy step-ca 가 발급한다: 루트만 신뢰(ADR 0060)
					dial_timeout 1s
					response_header_timeout 55s
				}
			}
		}
		handle @device_ok {
			# 마감: 환자 요청이 gateway 에서 쓰는 시간의 상한은 dial_timeout + response_header_timeout 이다(Go 의 두 타이머는 순차: 연결을 맺은 뒤 요청을 다 쓴 시점부터 응답 헤더를 기다린다).
			# 이 합이 키오스크 대기(60초)보다 짧아야 하고(여기 1s + 55s = 56s), 서버 턴 총 마감(SURVEY_TURN_DEADLINE_SECONDS 50초, config/survey.env)보다는 길어야 서버의 실패 응답이 gateway 의 504 보다 먼저 온다(여유 6s). 값의 근거는 ADR 0051(D125).
			# 연결 거부·이름 해석 실패는 dial 단계에서 끝나 1초대에 502->503 이 된다. 재시도 없음(lb_try_duration 0): 같은 요청을 게이트웨이가 다시 보내지 않는다. 키오스크가 같은 turn_id 로 다시 보낸다.
			reverse_proxy https://survey-service {
				header_up X-Forwarded-Host {http.request.hostport}   # 왜: 사이드카가 X-Forwarded-* 를 이웃(사설망)에게서 그대로 받는다(trusted_proxies). 원래 Host 를 앱이 알아야 하는 서비스(Keycloak)용
				header_up Host {upstream_hostport}   # 왜: 상류 사이드카는 서비스 이름 사이트로 TLS 를 끝낸다(Host 로 사이트를 고른다). 원래 Host 는 X-Forwarded-Host 로 남는다
				header_up -X-Openit-Dn
				header_up -X-Openit-Device   # 클라이언트가 보낸 기기 헤더는 항상 지운다(게이트웨이만 인증서에서 붙인다, 계약 PUBLIC_API F절)
				header_up -X-Openit-User   # Authorization 은 바꾸지 않는다: 검증한 기기 토큰이 그대로 survey 에 가서 survey 가 같은 기기 토큰 표로 세션 소유 기기를 확인한다(D88/U8)
				header_up -X-Openit-Roles
				lb_try_duration 0
				transport http {
					tls_trusted_ca_certs /etc/openit/pki/root_ca.crt   # 서비스 사이드카 인증서는 deploy step-ca 가 발급한다: 루트만 신뢰(ADR 0060)
					dial_timeout 1s
					response_header_timeout 55s
				}
			}
		}
		handle {
			header WWW-Authenticate "Bearer"
			respond "unauthorized: 기기 인증서(또는 2.x 호환 기기 토큰)가 없거나 틀리다" 401
		}
	}
	# 사람 인증 경로(U82, ADR 0057): /oauth2/* 는 oauth2-proxy(로그인 시작·콜백·로그아웃·/oauth2/userinfo), /auth/* 는 Keycloak(KC_HTTP_RELATIVE_PATH=/auth: 로그인·가입 화면, realm openit 의 관리 화면).
	# 로그인 자체라 인증 없이 열린다. /oauth2/auth 는 gateway 가 forward_auth 로 안에서만 부르는 길이라 밖에는 닫는다. Keycloak 의 master realm(부트스트랩 관리자)은 밖에 열지 않는다: 관리는 realm openit 의 admin 그룹 계정으로 한다.
	@oauth2internal path /oauth2/auth
	handle @oauth2internal {
		respond "not found" 404
	}
	handle /oauth2/* {
		reverse_proxy https://oauth2-proxy {
			header_up X-Forwarded-Host {http.request.hostport}   # 왜: 사이드카가 X-Forwarded-* 를 이웃(사설망)에게서 그대로 받는다(trusted_proxies). 원래 Host 를 앱이 알아야 하는 서비스(Keycloak)용
			header_up Host {upstream_hostport}   # 왜: 상류 사이드카는 서비스 이름 사이트로 TLS 를 끝낸다(Host 로 사이트를 고른다). 원래 Host 는 X-Forwarded-Host 로 남는다
			header_up -X-Openit-Dn
			header_up -X-Openit-Device
			header_up -X-Openit-User
			header_up -X-Openit-Roles
			header_down Cache-Control "no-store"
			lb_try_duration 0
			transport http {
				tls_trusted_ca_certs /etc/openit/pki/root_ca.crt   # 서비스 사이드카 인증서는 deploy step-ca 가 발급한다: 루트만 신뢰(ADR 0060)
				dial_timeout 2s
				response_header_timeout 10s
			}
		}
	}
	@kcmaster path /auth/realms/master /auth/realms/master/* /auth/admin/master /auth/admin/master/*
	handle @kcmaster {
