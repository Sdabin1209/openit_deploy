{
	admin off
	auto_https off
}
# 토큰은 환경 변수가 아니라 Caddy 표준 파일 치환 {file./run/secrets/<이름>} 으로 읽는다(D84; 설정을 읽을 때 한 번 치환되고 컨테이너 환경에 값이 없다).
# 인증 블록(D85 E절): 직원·운영자·승인자·검토자를 개별 계정으로 인증한다. 계정과 해시, 계정 -> 역할은 생성된 비밀 파일(secrets/gateway-accounts.caddy)에 있다
# (원본 목록은 config/gateway-accounts.conf, 만드는 것은 scripts/gen-secrets.sh). 이 파일이 두 조각을 정의한다:
#   (authenticate)   인증 블록. 통과하면 {http.auth.user.id} 에 계정 ID 가 든다. 병원 IdP(OIDC)가 정해지면 **이 블록만** 교체한다(docs/RUN.md 4-1-2).
#   (role_matchers)  @role_staff / @role_operator / @role_approver / @role_reviewer. 계정 -> 역할 매핑.
# 이 Caddyfile 의 나머지는 위 두 조각의 이름만 안다(basic_auth 를 직접 쓰지 않는다).
import /etc/caddy/accounts.caddy
# 키오스크 기기 인증(D85 F절): (kiosk_devices) 가 @device_ok 를 정의한다. 기기 토큰 목록은 secrets/gateway-devices.caddy (scripts/kiosk-add-device.sh).
import /etc/caddy/devices.caddy
# 사람이 쓰는 화면(승인·운영·검토)과 정적 화면의 상류 상한(FAULT_POLICY 4·6): 환자 경로(연결 1s + 헤더 8.5s, 키오스크 대기 10s 안)와 달리 키오스크의 10초 한도가 없다.
# 대신 화면이 무한정 매달리지 않게 상한을 둔다. 연결 2s(같은 서버의 컨테이너라 거의 즉시, 느리면 장애), 응답 헤더는 인자로 받는다: release-gate 15s(승인 결정·활성화·롤백은 DB 쓰기와 번들 검증을
# 거칠 수 있어 읽기보다 길게 잡은 시작값, 실측 근거 없음), ops-feedback·정적 화면 10s. 값은 시작값이며 사용자 결정이 아니다. 재시도 없음. 초과하면 아래 handle_errors 가 503/504 UPSTREAM_UNAVAILABLE 을 준다.
(proxy_limits) {
	lb_try_duration 0
	transport http {
		dial_timeout 2s
		response_header_timeout {args[0]}
	}
}
:8080 {
	import role_matchers
	import kiosk_devices
	# 접근 로그: 요청 본문은 남기지 않는다(Caddy는 본문을 기록하지 않는다). Authorization 헤더는 Caddy가 REDACTED로 바꾼다.
	log {
		output stdout
		format json
	}
	# 요청 본문 상한(점검 B4·D5·G3): 사이트 기본 8MiB(계약 상한), 사람이 쓰는 승인·운영·검토 경로는 1MiB(JSON 몇 줄뿐). 초과하면 Caddy 가 413 으로 끊는다. 값은 시작값이다.
	request_body {
		max_size 8MiB
	}
	# 보안 헤더(B7): 정적 화면 이미지가 같은 헤더를 이미 붙이더라도 gateway 가 한 곳에서 보장한다. 마이크(STT)를 쓰는 키오스크 때문에 Permissions-Policy 는 두지 않는다.
	# HSTS(Strict-Transport-Security)는 TLS 가 정해지기 전에 켜면 HTTP 접속을 막으므로 도메인·인증서(사용자 결정 U5)가 정해진 뒤에 아래 줄의 주석을 푼다.
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		-Server
		#Strict-Transport-Security "max-age=31536000"
	}
	handle /healthz {
		respond "ok" 200
	}
	# /readyz: 환자 경로의 survey-service /readyz 를 반영한다(FAULT_POLICY 5). 2xx 면 "ok" 200, 아니면 서비스의 상태 코드를 그대로 두되 본문은 {"ready":false} 만(서비스의 내부 문제 목록은 밖에 내지 않는다).
	# 상류에 닿지 못하면 아래 handle_errors 가 503/504 와 UPSTREAM_UNAVAILABLE 을 준다. /healthz 는 상류와 무관한 정적 200.
	handle /readyz {
		reverse_proxy survey-service:8080 {
			lb_try_duration 0
			transport http {
				dial_timeout 1s
				response_header_timeout 2s
			}
			@up status 2xx
			handle_response @up {
				respond "ok" 200
			}
			handle_response {
				header Content-Type application/json
				header Cache-Control no-store
				respond `{"ready":false}` {rp.status_code}
			}
		}
	}
	# 직원 API와 개입: 개별 계정 인증 + staff 역할 뒤에만 staff 서비스 토큰을 붙인다. 인증된 계정 ID 를 X-Openit-User 로 붙이고(개입 기록의 staff_id, 클라이언트가 보낸 값은 덮어씀) 본문 값은 믿지 않는다.
	# SSE는 버퍼링을 끄고 읽기 제한 시간을 길게, Last-Event-ID와 id는 그대로 전달한다.
	@staffapi path /v1/staff/* /v1/sessions/*/intervention
	handle @staffapi {
		import authenticate
		handle @role_staff {
			reverse_proxy survey-service:8080 {
				header_up Authorization "Bearer {file./run/secrets/survey-api-staff}"
				header_up X-Openit-User "{http.auth.user.id}"
				flush_interval -1
				lb_try_duration 0
				transport http {
					dial_timeout 2s
					response_header_timeout 10s
					read_timeout 1h
				}
			}
		}
		handle {
			respond "forbidden: staff 역할이 아니다" 403
		}
	}
	# 출고 승인 화면(admin-console): 사람 인증 뒤에만, release-gate의 승인 경로 네 개만 프록시한다: 읽기(GET) 두 경로는 release-approver **읽기** 토큰, 결정(POST /v1/approvals)은 release-approver **쓰기** 토큰을 붙인다(게이트는 읽기 면에서 쓰기 토큰을 403으로 거부한다).
	# 열지 않는 것: POST /v1/submissions, /v1/releases/*  (아래 handle /v1/* 가 404). /v1/active-pointer, /v1/releases, /v1/activate, /v1/rollback 은 아래 운영자 블록에서만 연다.
	# 인증된 사용자 ID를 X-Openit-User 로 붙이고 클라이언트가 보낸 같은 이름 헤더는 덮어쓴다(D69). 응답의 X-Openit-Report-Hash 는 그대로 통과하고 Cache-Control 은 no-store를 유지한다.
	@adminread {
		method GET
		path /v1/submissions /v1/submissions/*
	}
	@adminwrite {
		method POST
		path /v1/approvals
	}
	handle @adminread {
		import authenticate
		handle @role_approver {
			reverse_proxy release-gate:8080 {
				import proxy_limits 15s
				header_up Authorization "Bearer {file./run/secrets/gate-read-release-approver}"
				header_up X-Openit-User "{http.auth.user.id}"
				header_down Cache-Control "no-store"
			}
		}
		handle {
			respond "forbidden: release-approver 역할이 아니다" 403
		}
	}
	handle @adminwrite {
		import authenticate
		request_body {
			max_size 1MiB
		}
		handle @role_approver {
			reverse_proxy release-gate:8080 {
				import proxy_limits 15s
				header_up Authorization "Bearer {file./run/secrets/gate-write-release-approver}"
				header_up X-Openit-User "{http.auth.user.id}"
				header_down Cache-Control "no-store"
			}
		}
		handle {
			respond "forbidden: release-approver 역할이 아니다" 403
		}
	}
	# 실패 사례 검토 화면(admin-console): reviewer 역할 계정만. 읽기 3경로는 ops-feedback 읽기 토큰, 검토 게시는 reviewer 쓰기 토큰.
	# 비식별 전 원본(POST /v1/traces 등 서비스 내부 면)은 열지 않는다. X-Openit-User 는 인증된 계정으로 덮어쓴다(클라이언트 값 무시).
	@reviewread {
		method GET
		path /v1/cases /v1/cases/* /v1/deidentified-traces/*
	}
	@reviewwrite {
		method POST
		path /v1/cases/*/review
	}
	handle @reviewread {
		import authenticate
		handle @role_reviewer {
			reverse_proxy ops-feedback-ingest:8080 {
				import proxy_limits 10s
				header_up Authorization "Bearer {file./run/secrets/ops-read-reviewer}"
				header_up X-Openit-User "{http.auth.user.id}"
				header_down Cache-Control "no-store"
			}
		}
		handle {
			respond "forbidden: reviewer 역할이 아니다" 403
		}
	}
	handle @reviewwrite {
		import authenticate
		request_body {
			max_size 1MiB
		}
		handle @role_reviewer {
			reverse_proxy ops-feedback-ingest:8080 {
				import proxy_limits 10s
				header_up Authorization "Bearer {file./run/secrets/ops-review-reviewer}"
				header_up X-Openit-User "{http.auth.user.id}"
				header_down Cache-Control "no-store"
			}
		}
		handle {
			respond "forbidden: reviewer 역할이 아니다" 403
		}
	}
	# 승인 화면 정적 파일: /admin/ 접두사를 떼고 전달한다(이미지는 /admin/ 을 모른다. 화면은 상대 경로 app.js·app.css 를 쓴다)
	redir /admin /admin/ permanent
	handle_path /admin/* {
		import authenticate      # 화면은 어느 역할이든 열린다. API는 위에서 역할로 막힌다
		reverse_proxy admin-console:8080 {
			import proxy_limits 10s
		}
	}
	# 운영자 경로(D85 E절, admin-console CR-004): 릴리스 운영 화면이 부르는 게이트 경로 넷은 operator 역할 계정 뒤에서만 연다. 아니면 403(인증 없으면 401).
	# 읽기(GET /v1/active-pointer, GET /v1/releases)는 operator **읽기** 토큰, 변경(POST /v1/activate, /v1/rollback)은 operator **쓰기** 토큰을 붙인다.
	# X-Openit-User 는 인증된 계정으로 덮어쓰고(release-gate 가 행위자로 기록) Cache-Control 은 no-store 를 유지한다. 열지 않는 것: /v1/releases/* (번들, I9 PUT 포함), 그 밖의 /v1/*.
	@operateread {
		method GET
		path /v1/active-pointer /v1/releases
	}
	@operatewrite {
		method POST
		path /v1/activate /v1/rollback
	}
	handle @operateread {
		import authenticate
		handle @role_operator {
			reverse_proxy release-gate:8080 {
				import proxy_limits 15s
				header_up Authorization "Bearer {file./run/secrets/gate-read-operator}"
				header_up X-Openit-User "{http.auth.user.id}"
				header_down Cache-Control "no-store"
			}
		}
		handle {
			respond "forbidden: operator 역할이 아니다" 403
		}
	}
	handle @operatewrite {
		import authenticate
		request_body {
			max_size 1MiB
		}
		handle @role_operator {
			reverse_proxy release-gate:8080 {
				import proxy_limits 15s
				header_up Authorization "Bearer {file./run/secrets/gate-write-operator}"
				header_up X-Openit-User "{http.auth.user.id}"
				header_down Cache-Control "no-store"
			}
		}
		handle {
			respond "forbidden: operator 역할이 아니다" 403
		}
	}
	# 키오스크 공개 API(PUBLIC_API.md, D85 F절): 기기 토큰(Authorization: Bearer, 기기마다 파일 하나)을 목록과 대조한 뒤에만 서비스 kiosk 토큰으로 바꿔 붙인다.
	# 토큰이 없거나 틀리면 401. 클라이언트가 보낸 X-Openit-User 는 지운다. /v1/staff 는 위에서만 staff 토큰을 받는다.
	# 위험 신호 입력(risk-source)과 결과 조회(result-reader)는 감지기·병원 시스템용 내부 면이다: 게이트웨이에 열지 않는다(D85). 키오스크 경로의 와일드카드가 삼키지 않게 먼저 닫는다.
	@internalsurvey path /v1/sessions/*/risk-signals /v1/results /v1/results/*
	handle @internalsurvey {
		respond "not found" 404
	}
	@kioskapi path /v1/sessions /v1/sessions/*
	handle @kioskapi {
		handle @device_ok {
			# 마감: 환자 요청이 gateway 에서 쓰는 시간의 상한은 dial_timeout + response_header_timeout 이다(Go 의 두 타이머는 순차: 연결을 맺은 뒤 요청을 다 쓴 시점부터 응답 헤더를 기다린다).
			# 이 합이 키오스크 대기(10초)보다 짧아야 하고(여기 1s + 8.5s = 9.5s), 서버 턴 총 마감(SURVEY_TURN_DEADLINE_SECONDS 기본 6초)보다는 길어야 서버의 실패 응답이 gateway 의 504 보다 먼저 온다(여유 2.5s).
			# 연결 거부·이름 해석 실패는 dial 단계에서 끝나 1초대에 502->503 이 된다. 재시도 없음(lb_try_duration 0): 같은 요청을 게이트웨이가 다시 보내지 않는다. 키오스크가 같은 turn_id 로 다시 보낸다.
			reverse_proxy survey-service:8080 {
				header_up Authorization "Bearer {file./run/secrets/survey-api-kiosk}"
				header_up -X-Openit-User
				lb_try_duration 0
				transport http {
					dial_timeout 1s
					response_header_timeout 8500ms
				}
			}
		}
		handle {
			header WWW-Authenticate "Bearer"
			respond "unauthorized: 기기 토큰이 없거나 틀리다" 401
		}
	}
	handle /v1/* {
		respond "not found" 404
	}
	# 직원 콘솔 정적 화면: 개별 계정 인증과 staff 역할 뒤에만. HTTPS 종단은 운영 도메인이 정해지면 여기에 더한다(STT·웹 푸시는 보안 출처 필요, 미정).
	handle /staff/* {
		import authenticate
		handle @role_staff {
			reverse_proxy kiosk-frontend:8080 {
				transport http {
					dial_timeout 2s
					response_header_timeout 10s
				}
			}
		}
		handle {
			respond "forbidden: staff 역할이 아니다" 403
		}
	}
	handle {
		reverse_proxy kiosk-frontend:8080 {
			transport http {
				dial_timeout 2s
				response_header_timeout 10s
			}
		}
	}
	# 상류 장애(FAULT_POLICY 6): Caddy 는 연결 거부·이름 해석 실패를 502, 시간 초과를 504 로 낸다(관찰: docs/E2E.md 5q·5w). 이를 연결 거부 = 503, 시간 초과 = 504 로 바꾸고
	# JSON 본문 {"code":"UPSTREAM_UNAVAILABLE"} 와 Retry-After 를 준다. 본문에 상류 주소·오류 문구를 넣지 않는다(Caddy 의 {http.error.*} 를 쓰지 않는다).
	handle_errors {
		@refused expression {http.error.status_code} in [502, 503]
		@timedout expression {http.error.status_code} == 504
		handle @refused {
			header Content-Type application/json
			header Retry-After 2
			header Cache-Control no-store
			respond `{"code":"UPSTREAM_UNAVAILABLE"}` 503
		}
		handle @timedout {
			header Content-Type application/json
			header Retry-After 2
			header Cache-Control no-store
			respond `{"code":"UPSTREAM_UNAVAILABLE"}` 504
		}
	}
}
