# 백업 설정 예시(D88/U6: 백업은 필수). 실제 값은 config/backup.env 에 적는다(비밀이 아니다). 이 파일이 없거나 BACKUP_DIR 이 비면 backup 잡은 거부(종료 코드 2)하고
# scripts/check-health.sh 가 CRIT 를 내며 `doctor.sh --require-backup`(운영 up.sh 가 부른다)이 기동을 막는다.
# 서버 밖 대상: BACKUP_DIR 은 이 서버의 디스크가 아니라 별도 장치(NFS/외장 디스크/원격 마운트)여야 한다. doctor 는 같은 파일시스템이면 경고한다.
BACKUP_DIR=
# 보존 14일(D88/U4 잠정 기본값, 병원 규정이 다르면 숫자만 바꾼다). 코드에 기본값은 없다.
BACKUP_RETENTION_DAYS=14
# 파일 저장소(볼륨) 백업 대상. models-data 는 어댑터 패키지, registry-data 는 로컬 레지스트리(큰 볼륨; CI가 이미지를 다시 올릴 수 있으면 빼도 된다).
BACKUP_FILE_STORES="gate-data models-data"
# 암호화(데이터베이스 덤프는 개인정보를 담는다): gpg 또는 age. 서버에는 **공개키(수신자)만** 둔다. 복호화 키는 서버 밖에서 사람이 보관한다.
#   gpg 예: gpg --armor --export <수신자> > config/backup-recipient.pub.asc 를 키를 가진 쪽에서 만들어 서버로 가져온다(비밀키는 가져오지 않는다)
BACKUP_ENCRYPT=none
BACKUP_RECIPIENT_FILE=
# 백업을 돌리는 주기(초)는 config/jobs.yaml 의 backup 잡 interval_seconds(86400 = 일일, D88/U6)에 있다.
