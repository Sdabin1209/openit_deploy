# 추론 서버(model-runtime) 설정(비밀 아님). 토큰은 secrets/model-serving.env (MODEL_RUNTIME_TOKENS, MODEL_RUNTIME_RELEASE_TOKEN).
# backend=fake 는 CPU 이미지의 개발·시험용 가짜 백엔드다(출력 고정). 운영 모델은 GPU 변형 이미지(VARIANT=gpu)와 backend=vllm 이고 GPU 서버 몫이다(CR-D08, D17).
# model-runtime 의 fake 백엔드는 MODEL_RUNTIME_ALLOW_FAKE=1 이 없으면 시작을 거부한다(E2E 는 별도 프로젝트의 추론 서버에 test/compose.fake-model.yaml 로, 데모는 demo/compose.demo-mimic.yaml 로 준다). 운영 기본 구성에 fake 를 몰래 두지 않기 위한 보호다.
MODEL_RUNTIME_BACKEND=vllm   # 운영 기본은 실제 모델이다(L29). fake·mimic 은 이 파일이 아니라 샌드박스 추론 compose(compose.inference.yaml, INFERENCE_ALLOW_FAKE=1)에서만 쓴다
# 문진 스키마는 이미지에 내장되어 있다(/opt/survey-schema, D72). MODEL_RUNTIME_SCHEMA_DIR 은 필요 없다
MODEL_RUNTIME_RELEASE_URL=https://release-gate
# MODEL_RUNTIME_BUNDLE_DIR 은 기본값(/var/lib/model-runtime/bundles)을 쓴다
# 요청 상한(계약 CONVENTIONS 시간표, D125): extract 20.0초, respond 25.0초(실패 판정 상한이며 목표 2초가 아니다; 첫 호출 JIT 컴파일 같은 정상 지연에 실패하지 않게). model-runtime v0.11.4 에서 확인한 서버 기본값은 respond 2.0초라 명시하지 않으면 배포에서 respond 가 서버 쪽 2초에 잘린다. 사슬: survey 턴 50초 > 추출 20 + 응답 25(ADR 0051, scripts/test_time_chain.py 가 대조).
MODEL_RUNTIME_EXTRACT_DEADLINE_S=20.0
MODEL_RUNTIME_RESPOND_DEADLINE_S=25.0
# 운영 프로파일(계약 ModelServingEnv: vllm 이면 필수). 운영 기준 GPU 는 24GB급(D81, rtx4090-24g). 12GB 개발기는 compose.llm.yaml 의 DEMO_LLM_PROFILE 로 덮는다
MODEL_RUNTIME_PROFILE=/app/profiles/rtx4090-24g.json
