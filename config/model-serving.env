# 추론 서버(model-runtime) 설정(비밀 아님). 토큰은 secrets/model-serving.env (MODEL_RUNTIME_TOKENS, MODEL_RUNTIME_RELEASE_TOKEN).
# backend=fake 는 CPU 이미지의 개발·시험용 가짜 백엔드다(출력 고정). 운영 모델은 GPU 변형 이미지(VARIANT=gpu)와 backend=vllm 이고 GPU 서버 몫이다(CR-D08, D17).
# model-runtime 의 fake 백엔드는 MODEL_RUNTIME_ALLOW_FAKE=1 이 없으면 시작을 거부한다(시험 구성 compose.test.yaml·test/compose.fake-model.yaml 이 준다). 운영 기본 구성에 fake 를 몰래 두지 않기 위한 보호다.
MODEL_RUNTIME_BACKEND=fake
# 문진 스키마는 이미지에 내장되어 있다(/opt/survey-schema, D72). MODEL_RUNTIME_SCHEMA_DIR 은 필요 없다
MODEL_RUNTIME_RELEASE_URL=http://release-gate:8080
# MODEL_RUNTIME_BUNDLE_DIR 은 기본값(/var/lib/model-runtime/bundles)을 쓴다
# 요청 상한(계약 CONVENTIONS 시간표, D119): extract 3.0초, respond 5.0초. model-runtime v0.11.4 서버 기본값은 respond 2.0초라 명시하지 않으면 배포에서 respond 가 서버 쪽 2초에 잘린다. 사슬: survey 턴 9초 > 추출 3 + 응답 5(ADR 0047, scripts/test_time_chain.py)
MODEL_RUNTIME_EXTRACT_DEADLINE_S=3.0
MODEL_RUNTIME_RESPOND_DEADLINE_S=5.0
