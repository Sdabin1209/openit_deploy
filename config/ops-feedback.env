# ops-feedback 설정(비밀 아님). 로그·실패 사례 저장소는 PostgreSQL이다: OPS_LOG_DATABASE_URL_FILE, OPS_FAILURE_DATABASE_URL_FILE 이 compose environment 에 있다(D85).
# 예전의 OPS_FAILURE_DB(SQLite 경로)는 뺐다. I7 읽기 면이 DB URL 만으로 켜지는지는 ops-feedback 이미지로 확인해야 한다(미검증).
OPS_DB_SCHEMA=verify        # L08: 서버는 스키마를 만들지 않고 최신인지 확인만 한다(apply 는 시작 거부). 스키마는 ops-feedback-migrate(소유자 계정)가 만든다. 계약 OpsFeedbackServerEnv 기본값
OPS_RAW_RETENTION_DAYS=30   # D88/U4: 처리 끝난 원본 Trace 보존 일수. 잡 설정(ops-feedback-job.yaml retention.raw_days)과 같은 값. 없으면 /readyz 가 경고한다
