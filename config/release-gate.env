# gate-service와 수집 잡 설정(비밀 아님). I1·I3는 HTTP 클라이언트(D49). URL의 호스트는 Compose 서비스 이름이다.
# 토큰은 secrets/release-gate.env, secrets/release-gate-job.env 의 GATE_I1_TOKEN, GATE_I3_TOKEN.
# GATE_POLICY_FILE 은 여기에 없다: 정책 파일이 없으면 기본 정책(human-approval-1, 계약 GatePolicy)을 쓴다. 통과 임계치는 없고 PASS 는 release-approver 의 승인으로만 나온다(D53).
GATE_I1_URL=https://question-authoring
GATE_I3_URL=https://model-registry
GATE_POLL_SECONDS=60
# 지원하는 문진 스키마 정수 버전(계약 GateEnv 필수, 3.2.0). 값은 기준표의 문진 스키마(scripts/lib.sh DEPLOY_SS_TAG)의 정수 버전(모델 입출력이 바뀌지 않아 1 유지, 헤드 확인 2026-11-03) 과 같아야 한다. 기본값에 맡기면 호환 검사가 무력화된다(release-gate 담당 확인 2026-11-03)
GATE_SUPPORTED_RUNTIME_CONTRACT_VERSION=1
