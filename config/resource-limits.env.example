# 컨테이너 자원 한도 변수(감사 A9·F3). 값은 모두 "측정 안 함"인 시작값이고 compose.yaml 에 같은 기본값이 있다.
# 바꾸려면 이 줄을 deploy 루트의 .env 에 복사해 고친다(scripts/lib.sh 의 dc 가 .env 를 읽는다). 근거와 한계: docs/adr/0023-compose-resource-limits.md
# 실측(H1: GPU 서버, 환자 부하)으로 재정한다. 호스트 총 메모리보다 합이 크면 의미가 없으니 서버에 맞게 확인한다.
# 형식: <서비스>_MEM_LIMIT(예 512m, 2g), <서비스>_CPUS(코어 수, 소수 가능), <서비스>_PIDS_LIMIT(프로세스·스레드 수 상한)
#POSTGRES_MEM_LIMIT=2g
#POSTGRES_CPUS=2.0
#POSTGRES_PIDS_LIMIT=300
#POSTGRES_SHM_SIZE=256m
#POSTGRES_MAX_CONNECTIONS=100
#POSTGRES_IDLE_TX_TIMEOUT_MS=300000
#PG_ROLE_CONN_LIMIT=20             # 계정별 연결 상한(pg-roles.sh sync 로 적용)
#GATEWAY_MEM_LIMIT=256m
#GATEWAY_CPUS=1.0
#GATEWAY_PIDS_LIMIT=256
#KIOSK_FRONTEND_MEM_LIMIT=128m
#KIOSK_FRONTEND_CPUS=0.5
#KIOSK_FRONTEND_PIDS_LIMIT=128
#ADMIN_CONSOLE_MEM_LIMIT=128m
#ADMIN_CONSOLE_CPUS=0.5
#ADMIN_CONSOLE_PIDS_LIMIT=128
#SURVEY_SERVICE_MEM_LIMIT=512m
#SURVEY_SERVICE_CPUS=1.0
#SURVEY_SERVICE_PIDS_LIMIT=256
#QUESTION_AUTHORING_MEM_LIMIT=512m
#QUESTION_AUTHORING_CPUS=1.0
#QUESTION_AUTHORING_PIDS_LIMIT=256
#OPS_FEEDBACK_INGEST_MEM_LIMIT=512m
#OPS_FEEDBACK_INGEST_CPUS=1.0
#OPS_FEEDBACK_INGEST_PIDS_LIMIT=256
#RELEASE_GATE_MEM_LIMIT=1g
#RELEASE_GATE_CPUS=1.0
#RELEASE_GATE_PIDS_LIMIT=256
#MODEL_SERVING_MEM_LIMIT=1g         # fake/CPU 변형. 실제 LLM(compose.llm.yaml)은 아래 MODEL_SERVING_LLM_* 가 덮는다
#MODEL_SERVING_CPUS=2.0
#MODEL_SERVING_PIDS_LIMIT=512
#MODEL_SERVING_LLM_MEM_LIMIT=16g
#MODEL_SERVING_LLM_CPUS=4.0
#MODEL_SERVING_LLM_PIDS_LIMIT=2048
#MODEL_REGISTRY_MEM_LIMIT=512m
#MODEL_REGISTRY_CPUS=1.0
#MODEL_REGISTRY_PIDS_LIMIT=256
#DATASET_STORE_MEM_LIMIT=512m
#DATASET_STORE_CPUS=1.0
#DATASET_STORE_PIDS_LIMIT=256
#JOB_OPS_FEEDBACK_MEM_LIMIT=1g
#JOB_OPS_FEEDBACK_CPUS=1.0
#JOB_OPS_FEEDBACK_PIDS_LIMIT=256
#JOB_RELEASE_GATE_COLLECT_MEM_LIMIT=512m
#JOB_RELEASE_GATE_COLLECT_CPUS=1.0
#JOB_RELEASE_GATE_COLLECT_PIDS_LIMIT=256
# 레지스트리(compose.registry.yaml, 별도 프로젝트)
#REGISTRY_MEM_LIMIT=512m
#REGISTRY_CPUS=1.0
#REGISTRY_PIDS_LIMIT=128
#JOB_SURVEY_PURGE_MEM_LIMIT=256m
#JOB_SURVEY_PURGE_CPUS=0.5
#JOB_SURVEY_PURGE_PIDS_LIMIT=128
#JOB_QUESTION_AUTHORING_PURGE_MEM_LIMIT=256m
#JOB_QUESTION_AUTHORING_PURGE_CPUS=0.5
#JOB_QUESTION_AUTHORING_PURGE_PIDS_LIMIT=100
#JOB_RELEASE_GATE_PRUNE_MEM_LIMIT=256m
#JOB_RELEASE_GATE_PRUNE_CPUS=0.5
#JOB_RELEASE_GATE_PRUNE_PIDS_LIMIT=100
