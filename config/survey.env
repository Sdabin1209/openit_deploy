# survey-service 설정(비밀 아님). 영역 사이 호출은 HTTP(D49). URL의 호스트는 Compose 서비스 이름(내부 네트워크 이름)이다.
SURVEY_RELEASE_READER=http
SURVEY_RELEASE_READER_URL=http://release-gate:8080
SURVEY_RELEASE_READER_TOKEN_ENV=SURVEY_RELEASE_READER_TOKEN
SURVEY_TRACE_INGEST=http
SURVEY_TRACE_INGEST_URL=http://ops-feedback-ingest:8080
SURVEY_TRACE_INGEST_TOKEN_ENV=SURVEY_TRACE_INGEST_TOKEN
# 모델은 추론 서버(model-serving)를 거친다(I9, HTTP). 서비스는 어댑터를 보내지 않고 서버가 게이트(I4)에서 번들을 직접 읽는다.
SURVEY_INFERENCE_URL=http://model-serving:8080
SURVEY_INFERENCE_TOKEN_ENV=SURVEY_INFERENCE_TOKEN
SURVEY_RELEASE_POLL_SECONDS=5
# 보존(D88/U4, 잠정 기본값): 세션 종료 후 90일이 지나면 job-survey-purge(스케줄러, config/jobs.yaml)가 지운다. 병원 규정이 다르면 숫자만 바꾼다. 비우면 아무것도 지우지 않는다(무기한이라 권하지 않는다).
SURVEY_SESSION_RETENTION_DAYS=90
# 시간 상한 사슬(사용자 결정 2026-10-30, 바깥이 안쪽보다 길다): 키오스크 대기 12s > gateway 10.5s(Caddyfile: 연결 1s + 응답 헤더 9.5s) > survey 턴 총 마감 9s > 값 추출 3s + 응답 생성 5s(= 8s). 정적 시험 scripts/test_time_chain.py 가 이 파일·Caddyfile·e2e_steps.py 상수에서 읽어 검사한다(ADR 0003).
SURVEY_INFERENCE_EXTRACT_TIMEOUT_SECONDS=3.0
SURVEY_INFERENCE_RESPOND_TIMEOUT_SECONDS=5.0
SURVEY_TURN_DEADLINE_SECONDS=9.0
