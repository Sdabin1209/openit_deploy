# 주기 잡 release-gate-collector: 후보 수집기 run-once(D39). I1·I3를 HTTP로 읽어 새 조합을 접수한다(멱등). 예시이며 이 리포는 설치하지 않는다(경로 /srv/deploy 와 사용자 openit 은 서버에 맞게 바꾼다). ADR 0036.
# 실행은 oneshot 이라 같은 잡이 실행 중이면 timer 가 다시 시작하지 않는다(옛 스케줄러의 잠금과 같은 성질). 결과·종료 코드는 journald: journalctl -u openit-release-gate-collector.service
[Unit]
Description=openit 주기 잡 release-gate-collector
Wants=docker.service
After=docker.service

[Service]
Type=oneshot
User=openit
WorkingDirectory=/srv/deploy
Environment=DEPLOY_PROJECT=deploy
# 잡 하나의 제한 시간: 옛 스케줄러의 기본값 3600초를 그대로 옮겼다(근거 없는 시작값, 측정 안 함)
TimeoutStartSec=3600
ExecStart=/srv/deploy/scripts/run-job.sh job-release-gate-collect
# 실행 결과를 Prometheus(node_exporter textfile)에 남긴다(ADR 0037). 실패해도 ExecStopPost 는 실행된다
ExecStopPost=/srv/deploy/scripts/job-metrics.sh release-gate-collector 600
