# 주기 잡 survey-backup: 영역의 백업 잡(RUNTIME R10.1). 멱등. 한 번에 하나는 oneshot 유닛이 지킨다(R10.12).
# 실행은 oneshot 이라 같은 잡이 실행 중이면 timer 가 다시 시작하지 않는다(옛 스케줄러의 잠금과 같은 성질). 결과·종료 코드는 journald: journalctl -u openit-survey-backup.service
[Unit]
Description=openit 주기 잡 survey-backup
Wants=docker.service
After=docker.service

[Service]
Type=oneshot
User=openit
WorkingDirectory=/srv/deploy
Environment=DEPLOY_PROJECT=deploy
# 잡 하나의 제한 시간: 옛 스케줄러의 기본값 3600초를 그대로 옮겼다(근거 없는 시작값, 측정 안 함)
TimeoutStartSec=3600
ExecStart=/srv/deploy/scripts/run-job.sh job-survey-backup
# 실행 결과를 Prometheus(node_exporter textfile)에 남긴다(ADR 0037). 실패해도 ExecStopPost 는 실행된다
ExecStopPost=/srv/deploy/scripts/job-metrics.sh survey-backup 86400
