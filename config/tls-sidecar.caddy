# 서비스 TLS 사이드카 설정(ADR 0060). 서비스마다 같은 파일을 쓰고 이름·상류만 환경 변수다(12-Factor III): TLS_NAME(서비스 이름 = 인증서 이름), TLS_UPSTREAM(같은 네트워크 네임스페이스의 앱, 보통 127.0.0.1:8080).
# 인증서는 파일이다(/certs/tls.crt, tls.key): <서비스>-cert 가 step-ca 에서 일회용 토큰(OTT)으로 받고 renew 데몬이 갱신한다. ACME 도전을 쓰지 않는 이유는 ADR 0060.
{
	admin unix//tmp/caddy.sock   # 인증서 갱신 때 사이드카의 감시 루프가 reload 한다(TCP 포트를 열지 않는다)
	skip_install_trust
	persist_config off
	auto_https off
	storage file_system /data/caddy
	servers {
		trusted_proxies static private_ranges   # 게이트웨이(같은 사설망)가 붙인 X-Forwarded-* 를 지우지 않는다
	}
}
# 서비스 이름 사이트: 서빙 인증서 SAN 은 <서비스>-cert 가 토큰으로 받은 서비스 이름(과 토큰이 정한 별칭)뿐이다(RUNTIME.md R1.2). Caddy 의 자동 인증서(local CA)가 생기지 않게 사이트 이름은 서비스 이름 하나다.
https://{$TLS_NAME} {
	tls /certs/tls.crt /certs/tls.key
	reverse_proxy {$TLS_UPSTREAM:127.0.0.1:8080}
	# 앱에 닿지 못하면(연결 거부·타임아웃) 응답을 만들지 않고 연결을 끊는다. 빈 502 를 돌려주면 호출자(게이트웨이)가 그것을 정상 응답으로 받아 계약 503 UPSTREAM_UNAVAILABLE 을 못 만든다:
	# 끊김이면 게이트웨이는 상류 프록시 오류로 보고 자기 handle_errors 가 503 + Retry-After 를 낸다(오류 형식은 게이트웨이 한 곳). 서비스 사이 계약 클라이언트는 끊김을 UNAVAILABLE 로 받는다
	handle_errors {
		abort
	}
}
# 그 밖의 Host: 같은 호스트에서 localhost 로 부르는 점검은 Host 매처로 받는다(사이트 이름이 localhost 가 되면 Caddy 가 local CA 인증서를 만들려 한다, R1.2). 나머지는 421 Misdirected Request(RFC 9110 15.5.20)로
# 거절하고 앱으로 넘기지 않는다(맞는 사이트가 없을 때 Caddy 는 본문 없는 200 을 돌려줘 상태 코드만 보는 점검이 헛통과했다, 4차 E2E).
https:// {
	tls /certs/tls.crt /certs/tls.key
	@local host {$TLS_ALT_NAME:localhost}
	handle @local {
		reverse_proxy {$TLS_UPSTREAM:127.0.0.1:8080}
	}
	handle {
		respond "misdirected request" 421
	}
	handle_errors {
		abort
	}
}
