{
  "jobs": [
    {
      "name": "release-gate-collect",
      "argv": [
        "python",
        "-m",
        "release_gate",
        "collect"
      ],
      "idempotent": false,
      "secret_files": [
        "GATE_DATABASE_URL_FILE",
        "GATE_I1_TOKEN_FILE",
        "GATE_I3_TOKEN_FILE"
      ],
      "needs": [
        "postgres",
        "gate-data",
        "release-network"
      ]
    },
    {
      "name": "release-gate-prune",
      "argv": [
        "python",
        "-m",
        "release_gate",
        "prune"
      ],
      "idempotent": true,
      "secret_files": [
        "GATE_DATABASE_URL_FILE"
      ],
      "needs": [
        "postgres",
        "gate-data"
      ]
    },
    {
      "name": "ops-feedback-job",
      "argv": [
        "python",
        "-m",
        "ops_feedback.job",
        "--config",
        "/config/job.yaml"
      ],
      "idempotent": true,
      "secret_files": [
        "OPS_DEID_SALT_FILE",
        "OPS_GATE_READ_TOKEN_FILE",
        "OPS_GATE_WRITE_TOKEN_FILE",
        "OPS_LOG_DATABASE_URL_FILE",
        "OPS_FAILURE_DATABASE_URL_FILE"
      ],
      "config": {
        "container_path": "/config/job.yaml"
      },
      "needs": [
        "postgres",
        "logs-network",
        "release-network"
      ]
    },
    {
      "name": "survey-purge",
      "argv": [
        "python",
        "-m",
        "survey_service",
        "purge"
      ],
      "idempotent": true,
      "secret_files": [
        "SURVEY_DATABASE_URL_FILE"
      ],
      "needs": [
        "postgres"
      ]
    }
  ]
}
