{
  "service": "survey-service",
  "routes": [
    {
      "paths": [
        "/v1/sessions",
        "/v1/sessions/*"
      ],
      "auth": {
        "kind": "device-token"
      },
      "user_header": "strip",
      "timeouts_ms": {
        "dial": 1000,
        "response_header": 8500
      }
    },
    {
      "paths": [
        "/v1/staff/*",
        "/v1/sessions/*/intervention"
      ],
      "methods": [],
      "auth": {
        "kind": "account",
        "roles": [
          "staff"
        ]
      },
      "upstream_token": "survey-api-staff",
      "user_header": "set",
      "streaming": true,
      "timeouts_ms": {
        "dial": 2000,
        "response_header": 10000,
        "read": 3600000
      }
    },
    {
      "paths": [
        "/v1/sessions/*/risk-signals",
        "/v1/results",
        "/v1/results/*"
      ],
      "auth": {
        "kind": "denied"
      }
    }
  ]
}
