{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "BuildImageRequest.schema.json",
  "title": "BuildImageRequest",
  "description": "[제안] 영역 빌드 진입점 입력 (deploy -> 영역 scripts/build-image.sh). 제안이다(현재 영역에 이 진입점이 없다). 지금 deploy 의 build-images.sh 는 영역마다 다른 Dockerfile 인자 이름(COMMIT/REVISION, BOUNDARY_TAG/BC_VERSION/BOUNDARY_VERSION/BOUNDARY_CONTRACT 등)과 빌드 컨텍스트를 직접 안다. 진입점이 생기면 deploy 는 이 JSON 한 벌만 넘기고 인자 이름은 영역이 안다. 파일 경로 하나를 인자로 받는다.",
  "type": "object",
  "properties": {
    "source_dir": {
      "type": "string",
      "minLength": 1,
      "description": "영역 소스 트리(영역 자신의 리포 루트)"
    },
    "revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{7,40}$"
    },
    "versions": {
      "type": "object",
      "properties": {
        "boundary": {
          "type": "string",
          "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "turn_engine": {
          "type": "string",
          "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "model_runtime": {
          "type": "string",
          "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"
        }
      },
      "required": [
        "boundary",
        "turn_engine",
        "model_runtime"
      ],
      "additionalProperties": false
    },
    "image_tag": {
      "type": "string",
      "pattern": "^[a-z0-9./_-]+:[A-Za-z0-9._-]+$",
      "description": "만들 로컬 이미지 참조"
    }
  },
  "required": [
    "source_dir",
    "revision",
    "versions",
    "image_tag"
  ],
  "additionalProperties": false
}
