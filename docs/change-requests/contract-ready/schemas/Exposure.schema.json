{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "Exposure.schema.json",
  "title": "Exposure",
  "description": "서비스의 게이트웨이 노출 표 (라벨 io.openit.exposure 의 내용). 서비스(영역)가 어느 경로를 어떤 인증으로 밖에 내는지 선언하고 deploy 가 config/Caddyfile 을 만들거나 대조한다. 지금은 Caddyfile 이 영역 API 경로·메서드·역할을 직접 안다. 역할 이름은 boundary-contracts 의 역할 집합이어야 한다(여기서는 형식만 본다). 노출하지 않는 경로는 auth.kind=denied 로 적는다: 목록에 없는 /v1/* 는 gateway 가 404 로 막는 것이 기본이다.",
  "type": "object",
  "properties": {
    "service": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "routes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/route"
      }
    }
  },
  "required": [
    "service",
    "routes"
  ],
  "additionalProperties": false,
  "$defs": {
    "route": {
      "type": "object",
      "properties": {
        "paths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^/"
          }
        },
        "methods": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "GET",
              "POST",
              "PUT",
              "PATCH",
              "DELETE"
            ]
          },
          "description": "비우면 모든 메서드"
        },
        "auth": {
          "type": "object",
          "properties": {
            "kind": {
              "enum": [
                "device-token",
                "account",
                "none",
                "denied"
              ]
            },
            "roles": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[a-z][a-z-]*$"
              }
            }
          },
          "required": [
            "kind"
          ],
          "if": {
            "properties": {
              "kind": {
                "const": "account"
              }
            }
          },
          "then": {
            "required": [
              "roles"
            ],
            "properties": {
              "roles": {
                "minItems": 1
              }
            }
          },
          "additionalProperties": false
        },
        "upstream_token": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$",
          "description": "gateway 가 상류에 붙이는 서비스 토큰의 비밀 이름(값 아님)"
        },
        "user_header": {
          "enum": [
            "set",
            "strip"
          ],
          "description": "set=인증된 계정 ID 를 X-Openit-User 로 붙임(클라이언트 값은 덮어씀), strip=지움"
        },
        "streaming": {
          "type": "boolean"
        },
        "timeouts_ms": {
          "type": "object",
          "properties": {
            "dial": {
              "type": "integer",
              "minimum": 1
            },
            "response_header": {
              "type": "integer",
              "minimum": 1
            },
            "read": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "paths",
        "auth"
      ],
      "additionalProperties": false
    }
  }
}
