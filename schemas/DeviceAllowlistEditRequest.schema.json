{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "DeviceAllowlistEditRequest.schema.json",
 "title": "DeviceAllowlistEditRequest",
 "description": "기기 허용 목록 한 번의 고침(scripts/device_allowlist.py 의 명령). 기기 ID·일련번호의 형식은 여기서 막지 않는다: 컴포넌트가 계약 DeviceAllowlist·RFC 5280 으로 판정해 REJECTED 와 이유를 낸다(업무 결과, 입력 거부가 아니다).",
 "type": "object",
 "required": ["command", "exists", "current"],
 "additionalProperties": false,
 "properties": {
  "command": {"enum": ["add", "remove-serial", "remove", "has", "init", "list", "serials"]},
  "device_id": {"type": "string", "description": "기기 ID(인증서 주체 CN)"},
  "serial": {"type": "string", "description": "정규화 전 일련번호(16진수, 대문자·앞자리 0 허용)"},
  "exists": {"type": "boolean", "description": "목록 파일이 지금 있는가(init 은 없을 때만 만든다)"},
  "current": {"type": "object", "description": "지금 목록 파일을 JSON 으로 읽은 문서(없으면 빈 목록 {schema_version 1, devices []})"}
 },
 "allOf": [
  {"if": {"properties": {"command": {"enum": ["add", "remove-serial", "remove", "has", "serials"]}}, "required": ["command"]}, "then": {"required": ["device_id"]}},
  {"if": {"properties": {"command": {"enum": ["add", "remove-serial"]}}, "required": ["command"]}, "then": {"required": ["serial"]}}
 ]
}
