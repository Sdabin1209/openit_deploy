{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "JobCommandRequest.schema.json",
 "title": "JobCommandRequest",
 "type": "object",
 "required": [
  "docker",
  "image",
  "job",
  "config_path",
  "work",
  "secrets_dir",
  "uid",
  "gid",
  "network"
 ],
 "additionalProperties": false,
 "properties": {
  "docker": {
   "type": "string",
   "minLength": 1
  },
  "image": {
   "type": "string",
   "minLength": 1
  },
  "job": {
   "type": "object",
   "required": [
    "argv",
    "config"
   ],
   "additionalProperties": false,
   "properties": {
    "argv": {
     "type": "array",
     "minItems": 1,
     "items": {
      "type": "string"
     },
     "description": "컨테이너 안 명령(JobsDeclaration.jobs[].argv 그대로)"
    },
    "secret_files": {
     "type": "array",
     "items": {
      "enum": [
       "QUESTION_READER_TOKEN_FILE",
       "FAILURE_STORE_TOKEN_FILE",
       "DATASET_STORE_WRITE_TOKEN_FILE"
      ]
     },
     "description": "deploy 가 연결할 토큰을 아는 NAME_FILE 만. 모르는 이름은 거부(짐작해서 주지 않는다, D84)"
    },
    "config": {
     "type": "object",
     "required": [
      "container_path"
     ],
     "properties": {
      "container_path": {
       "type": "string",
       "pattern": "^/"
      }
     }
    }
   }
  },
  "config_path": {
   "type": "string",
   "minLength": 1
  },
  "work": {
   "type": "string",
   "minLength": 1,
   "description": "전용 호스트 작업 루트. 설정에서 선택한 쓰기 디렉터리는 이 루트의 자식이어야 한다. 루트 전체를 컨테이너에 마운트하지 않는다."
  },
  "secrets_dir": {
   "type": "string",
   "minLength": 1
  },
  "uid": {
   "type": "integer",
   "minimum": 0,
   "description": "작업 폴더를 준비한 호스트 사용자. 컨테이너 USER를 덮어쓰지 않는다."
  },
  "gid": {
   "type": "integer",
   "minimum": 0,
   "description": "호스트 작업 폴더 접근용 보조 그룹. 이미지 기본 사용자·그룹은 유지한다."
  },
  "extra_ro": {
   "type": "array",
   "items": {
    "type": "string",
    "minLength": 1
   }
  },
  "network": {
   "type": "string",
   "minLength": 1,
   "description": "기본값 없음: 호출자가 고른다(이웃을 부르는 잡은 compose 네트워크, 아니면 none)"
  },
  "pki_root_volume": {
   "type": "string",
   "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$",
   "description": "선택한 Docker 명명 볼륨의 공개 CA를 /etc/openit/pki 에 읽기 전용으로 연결하고 SSL_CERT_FILE 을 설정한다."
  },
  "container_name": {
   "type": "string",
   "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$",
   "description": "이 실행이 소유한 컨테이너 이름. 시간 초과 시 이 컨테이너만 정리한다."
  },
  "supplementary_groups": {
   "type": "array",
   "uniqueItems": true,
   "items": {
    "type": "integer",
    "minimum": 0,
    "maximum": 2147483647
   },
   "description": "주입하는 비밀 파일을 읽을 보조 그룹. 이미지 USER를 대체하지 않는다."
  },
  "mounts": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "source",
     "target",
     "read_only"
    ],
    "properties": {
     "source": {
      "type": "string",
      "pattern": "^/[^\\u0000]*(?![\\s\\S])"
     },
     "target": {
      "type": "string",
      "pattern": "^/[^\\u0000]*(?![\\s\\S])"
     },
     "read_only": {
      "type": "boolean"
     }
    }
   }
  },
  "tmpfs": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "path",
     "uid",
     "gid"
    ],
    "properties": {
     "path": {
      "type": "string",
      "pattern": "^/[^\\u0000]*(?![\\s\\S])"
     },
     "uid": {
      "type": "integer",
      "minimum": 0
     },
     "gid": {
      "type": "integer",
      "minimum": 0
     }
    }
   }
  },
  "read_only_root": {
   "type": "boolean"
  },
  "capabilities": {
   "type": "array",
   "uniqueItems": true,
   "items": {
    "type": "string",
    "pattern": "^[A-Z][A-Z0-9_]*$"
   }
  },
  "environment": {
   "type": "object",
   "propertyNames": {
    "pattern": "^[A-Z][A-Z0-9_]*$"
   },
   "additionalProperties": {
    "type": "string"
   }
  },
  "sysctls": {
   "$ref": "https://openit.example/schemas/ContainerInputs.schema.json#/$defs/InputSet/properties/sysctls"
  }
 }
}
