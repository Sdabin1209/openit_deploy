{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "JobCommandRequest.schema.json",
 "title": "JobCommandRequest",
 "type": "object",
 "required": [
  "docker",
  "image",
  "job",
  "config_path",
  "work",
  "secrets_dir",
  "uid",
  "gid",
  "network"
 ],
 "additionalProperties": false,
 "properties": {
  "docker": {
   "type": "string",
   "minLength": 1
  },
  "image": {
   "type": "string",
   "minLength": 1
  },
  "job": {
   "type": "object",
   "required": [
    "argv",
    "config"
   ],
   "additionalProperties": false,
   "properties": {
    "argv": {
     "type": "array",
     "minItems": 1,
     "items": {
      "type": "string"
     },
     "description": "컨테이너 안 명령(JobsDeclaration.jobs[].argv 그대로)"
    },
    "secret_files": {
     "type": "array",
     "items": {
      "enum": [
       "QUESTION_READER_TOKEN_FILE",
       "FAILURE_STORE_TOKEN_FILE",
       "DATASET_STORE_WRITE_TOKEN_FILE"
      ]
     },
     "description": "deploy 가 연결할 토큰을 아는 NAME_FILE 만. 모르는 이름은 거부(짐작해서 주지 않는다, D84)"
    },
    "config": {
     "type": "object",
     "required": [
      "container_path"
     ],
     "properties": {
      "container_path": {
       "type": "string",
       "pattern": "^/"
      }
     }
    }
   }
  },
  "config_path": {
   "type": "string",
   "minLength": 1
  },
  "work": {
   "type": "string",
   "minLength": 1
  },
  "secrets_dir": {
   "type": "string",
   "minLength": 1
  },
  "uid": {
   "type": "integer",
   "minimum": 0
  },
  "gid": {
   "type": "integer",
   "minimum": 0
  },
  "extra_ro": {
   "type": "array",
   "items": {
    "type": "string",
    "minLength": 1
   }
  },
  "network": {
   "type": "string",
   "minLength": 1,
   "description": "기본값 없음: 호출자가 고른다(이웃을 부르는 잡은 compose 네트워크, 아니면 none)"
  }
 }
}
