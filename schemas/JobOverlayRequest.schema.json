{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "JobOverlayRequest.schema.json",
 "title": "JobOverlayRequest",
 "type": "object",
 "required": [
  "jobs"
 ],
 "additionalProperties": false,
 "properties": {
  "jobs": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": [
     "compose_service",
     "declared"
    ],
    "additionalProperties": false,
    "properties": {
     "compose_service": {
      "type": "string",
      "description": "덧씌우기를 받는 compose 서비스: job-* 이거나 고정 목록의 일회성 선행 서비스",
      "anyOf": [
       {
        "pattern": "^job-[a-z][a-z0-9-]*$",
        "description": "주기·요청 잡 서비스"
       },
       {
        "enum": [
         "ops-feedback-migrate"
        ],
        "description": "명령을 이미지 잡 선언에서 받는 일회성 선행 서비스(CONVENTIONS 13절 3.4.17). 새 일회성 서비스는 여기에 더한다"
       }
      ]
     },
     "declared": {
      "type": "object",
      "required": [
       "name",
       "argv"
      ],
      "additionalProperties": true,
      "properties": {
       "name": {
        "type": "string"
       },
       "argv": {
        "type": "array",
        "minItems": 1,
        "items": {
         "type": "string"
        }
       },
       "timeout_seconds": {
        "type": "integer",
        "minimum": 1
       }
      },
      "description": "이미지 라벨 io.openit.jobs(계약 JobsDeclaration)의 잡 하나. 계약 검증은 내는 쪽(wiring)이 끝냈다"
     },
     "base_period_seconds": {
      "type": "integer",
      "minimum": 1,
      "description": "deploy 가 정한 기본 실행 주기(초, systemd 타이머의 OnUnitActiveSec). 없으면 0 으로 본다. 실제 주기는 max(기본 주기, 선언 상한보다 큰 가장 작은 5분 배수)다(RUNTIME R9.3)"
     },
     "config_source": {
      "type": "string",
      "minLength": 1,
      "description": "선언에 config(container_path)가 있을 때 그 파일을 마운트할 호스트 쪽 경로(deploy 가 정한 설정 파일, compose 변수 치환 허용)"
     }
    }
   }
  }
 }
}
