      "minItems": 1,
      "items": {
       "type": "string"
      }
     },
     "x-openit-timeout-seconds": {
      "type": "integer",
      "minimum": 1
     },
     "x-openit-period-seconds": {
      "type": "integer",
      "minimum": 1
     }
    }
   }
  }
 }
}
