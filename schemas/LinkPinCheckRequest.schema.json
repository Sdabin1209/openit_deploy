{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "LinkPinCheckRequest.schema.json",
 "title": "LinkPinCheckRequest",
 "type": "object",
 "required": [
  "expected_tag",
  "areas"
 ],
 "additionalProperties": false,
 "properties": {
  "expected_tag": {
   "type": "string",
   "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$",
   "description": "scripts/lib.sh 의 DEPLOY_LINK_TAG"
  },
  "areas": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": [
     "name",
     "files"
    ],
    "additionalProperties": false,
    "properties": {
     "name": {
      "type": "string",
      "minLength": 1
     },
     "files": {
      "type": "array",
      "items": {
       "type": "object",
       "required": [
        "path",
        "text"
       ],
       "additionalProperties": false,
       "properties": {
        "path": {
         "type": "string",
         "minLength": 1
        },
        "text": {
         "type": "string"
        }
       }
      },
      "description": "영역 main 브랜치의 잠금 후보 파일(requirements*.txt, *.lock, Dockerfile)"
     }
    }
   }
  }
 }
}
