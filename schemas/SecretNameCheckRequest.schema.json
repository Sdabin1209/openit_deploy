{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "SecretNameCheckRequest.schema.json",
 "title": "SecretNameCheckRequest",
 "type": "object",
 "required": [
  "areas",
  "compose_docs"
 ],
 "additionalProperties": false,
 "properties": {
  "areas": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "name",
     "files"
    ],
    "additionalProperties": false,
    "properties": {
     "name": {
      "type": "string",
      "minLength": 1
     },
     "files": {
      "type": "array",
      "items": {
       "type": "object",
       "required": [
        "path",
        "text"
       ],
       "additionalProperties": false,
       "properties": {
        "path": {
         "type": "string",
         "minLength": 1
        },
        "text": {
         "type": "string"
        }
       }
      },
      "description": "영역 리포의 git 추적 *.py"
     }
    }
   }
  },
  "compose_docs": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "file",
     "doc"
    ],
    "additionalProperties": false,
    "properties": {
     "file": {
      "type": "string",
      "minLength": 1
     },
     "doc": {
      "type": [
       "object",
       "null"
      ],
      "description": "compose 파일을 yaml 로 읽은 문서"
     }
    }
   }
  }
 }
}
