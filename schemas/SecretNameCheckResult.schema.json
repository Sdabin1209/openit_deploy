{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "SecretNameCheckResult.schema.json",
 "title": "SecretNameCheckResult",
 "type": "object",
 "required": [
  "status",
  "fails",
  "warns",
  "compose_names",
  "code_names"
 ],
 "additionalProperties": false,
 "properties": {
  "status": {
   "enum": [
    "OK",
    "FAIL",
    "NO_AREAS",
    "NO_COMPOSE_NAMES"
   ],
   "description": "NO_* 는 대조하지 못한 것(통과가 아니다)"
  },
  "fails": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "area",
     "where",
     "name"
    ],
    "additionalProperties": false,
    "properties": {
     "area": {
      "type": "string"
     },
     "where": {
      "type": "string"
     },
     "name": {
      "type": "string",
      "pattern": "_FILE$"
     }
    }
   }
  },
  "warns": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "name",
     "services"
    ],
    "additionalProperties": false,
    "properties": {
     "name": {
      "type": "string"
     },
     "services": {
      "type": "array",
      "items": {
       "type": "string"
      }
     }
    }
   }
  },
  "compose_names": {
   "type": "integer",
   "minimum": 0
  },
  "code_names": {
   "type": "integer",
   "minimum": 0
  }
 },
 "if": {
  "properties": {
   "status": {
    "const": "FAIL"
   }
  },
  "required": [
   "status"
  ]
 },
 "then": {
  "properties": {
   "fails": {
    "minItems": 1
   }
  }
 }
}
