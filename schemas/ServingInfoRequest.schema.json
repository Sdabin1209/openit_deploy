{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "ServingInfoRequest.schema.json",
 "title": "ServingInfoRequest",
 "type": "object",
 "required": [
  "url",
  "token",
  "timeout"
 ],
 "additionalProperties": false,
 "properties": {
  "url": {
   "type": "string",
   "pattern": "^https?://"
  },
  "token": {
   "type": "string",
   "minLength": 1
  },
  "timeout": {
   "type": "number",
   "exclusiveMinimum": 0
  }
 }
}
