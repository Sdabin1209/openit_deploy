{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "SetupEnvRecordResult.schema.json",
 "title": "SetupEnvRecordResult",
 "type": "object",
 "required": [
  "status"
 ],
 "additionalProperties": false,
 "properties": {
  "status": {
   "enum": [
    "STORE",
    "NO_LINE",
    "CONTRACT_VIOLATION"
   ]
  },
  "report": {
   "type": "object"
  },
  "message": {
   "type": "string",
   "minLength": 1
  }
 },
 "allOf": [
  {
   "if": {
    "properties": {
     "status": {
      "const": "STORE"
     }
    },
    "required": [
     "status"
    ]
   },
   "then": {
    "required": [
     "report"
    ]
   },
   "else": {
    "required": [
     "message"
    ]
   }
  }
 ]
}
