{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "root",
  "tokens"
 ],
 "title": "TokenDeliveryRequest",
 "$id": "TokenDeliveryRequest.schema.json",
 "properties": {
  "root": {
   "type": "string",
   "minLength": 1,
   "description": "Public CA PEM exported by the issuing CA.",
   "contentMediaType": "application/pem-certificate-chain"
  },
  "tokens": {
   "type": "object",
   "minProperties": 1,
   "propertyNames": {
    "$ref": "https://openit.example/schemas/StepCaEnv.schema.json#/$defs/DnsName"
   },
   "additionalProperties": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "value",
     "uid",
     "gid"
    ],
    "properties": {
     "value": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\r\\n]+(?![\\s\\S])",
      "writeOnly": true
     },
     "uid": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
     },
     "gid": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
     }
    }
   }
  }
 },
 "description": "Write public root to /r/root_ca.crt (0644) and each opaque token to /t/<name>.ott (0640), atomically. uid/gid are the declared start process of the consuming certificate client, never inferred from the token name."
}
