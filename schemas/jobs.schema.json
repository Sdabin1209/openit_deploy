{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openit.local/deploy/jobs.schema.json",
  "title": "config/jobs.yaml (주기 잡 정의)",
  "description": "사람이 쓰고 scripts/scheduler.py 가 읽는다. where=serving 은 이 서버에서 command 를 실행하고 interval_seconds 가 정수여야 한다. interval_seconds=null 은 '주기 미정'이며 실행하지 않는다. where=gpu-external 은 이 스케줄러가 실행하지 않는다(command 는 있어도 무시되고, 시험 설정은 이를 이용한다). 모르는 키는 거부한다(오타가 조용히 무시되면 잡이 안 도는 것을 모른다). deploy 내부 스키마(R5, audit DP-15).",
  "type": "object",
  "properties": {
    "jobs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/job"
      }
    }
  },
  "required": [
    "jobs"
  ],
  "additionalProperties": false,
  "$defs": {
    "job": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "where": {
          "enum": [
            "serving",
            "gpu-external"
          ]
        },
        "command": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "interval_seconds": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      },
      "required": [
        "name",
        "where",
        "interval_seconds"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "where": {
                "const": "serving"
              }
            }
          },
          "then": {
            "required": [
              "command"
            ]
          }
        }
      ]
    }
  }
}
