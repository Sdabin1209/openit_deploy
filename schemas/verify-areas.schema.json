{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openit.local/deploy/verify-areas.schema.json",
  "title": "config/verify-areas.yaml (영역별 시험 범위 대응표)",
  "description": "사람이 쓰고 scripts/verify_area.py 가 읽는다. e2e 가 auto 면 E2E 단계는 e2e_steps.py 의 @step 에서 계산하고 여기에 적지 않는다. none 은 이유(reason)가 필수다. deploy 내부 스키마(R5, audit DP-15).",
  "type": "object",
  "properties": {
    "default_skip_e2e_paths": {"type": "array", "items": {"type": "string"}},
    "areas": {"type": "object", "minProperties": 1, "propertyNames": {"pattern": "^[a-z][a-z0-9-]*$"}, "additionalProperties": {"$ref": "#/$defs/area"}}
  },
  "required": ["default_skip_e2e_paths", "areas"],
  "additionalProperties": false,
  "$defs": {
    "argv": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "area": {
      "type": "object",
      "properties": {
        "image": {"type": "array", "items": {"type": "string"}},
        "tests": {
          "type": "object",
          "properties": {
            "kind": {"enum": ["pytest", "npm", "commands"]},
            "commands": {"type": "array", "items": {"$ref": "#/$defs/argv"}},
            "also": {"type": "array", "items": {"$ref": "#/$defs/argv"}}
          },
          "required": ["kind"],
          "additionalProperties": false,
          "if": {"properties": {"kind": {"const": "commands"}}},
          "then": {"required": ["commands"]}
        },
        "e2e": {"enum": ["auto", "none", "fast"]},
        "reason": {"type": "string", "minLength": 1},
        "skip_e2e_paths": {"type": "array", "items": {"type": "string"}}
      },
      "required": ["image", "tests", "e2e"],
      "additionalProperties": false,
      "if": {"properties": {"e2e": {"const": "none"}}},
      "then": {"required": ["reason"]}
    }
  }
}
